import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Fmt } from "../util.slint";
import { Glyph, Icon } from "../icons.slint";
import { Editor } from "../editor.slint";
import { ClipKind, ClipTextField } from "../timeline/model.slint";
import { PaneKind } from "../workspace/pane-switcher.slint";
import { Seat } from "../workspace/seat.slint";

// The editor on a phone, held upright, laid out the way VN lays it out:
//
//   the project bar         back · frame shape · settings · save · export
//   the monitor             the picture, as large as the rest allows
//   the transport           time · start · play · end · undo · redo
//   the timeline            a third of the screen: the add buttons, then
//                           the lanes with the playhead fixed in the middle
//   the colour strip        only while a title is selected
//   the tool row            what can be added, or what can be done to the
//                           selected clip
//
// A tool that needs controls opens a sheet over the timeline and the tool
// row, and the monitor stays where it is above it, so what a slider does is
// seen as it is dragged.
//
// Nothing here is a second copy of a view. The monitor, the timeline, the
// library and the inspector are the desktop's own, in a Seat each, with
// their chrome taken off; this file is the arrangement and the tool row.

/// One button of the tool row.
export struct PhoneTool {
    /// What `run` is asked to do.
    id: string,
    glyph: Glyph,
    label: string,
}

component ToolButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <string> label;
    in property <bool> current;

    callback clicked();

    width: 68px;
    border-radius: Theme.r;
    background: touch.pressed || root.current ? Theme.field : Colors.transparent;

    VerticalLayout {
        alignment: center;
        spacing: 6px;

        HorizontalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                size: 22px;
                weight: 1.7;
                tint: root.current ? Theme.accent : Theme.fg;
            }
        }

        Text {
            text: root.label;
            color: root.current ? Theme.fg : Theme.fg-muted;
            font-size: Theme.fs-sm;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// A square icon button with a finger-sized target.
component BarButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <bool> enabled: true;
    in property <length> icon-size: 20px;

    callback clicked();

    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: touch.pressed ? Theme.field : Colors.transparent;
    opacity: root.enabled ? 1 : 0.4;

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: root.icon-size;
        weight: 1.8;
        tint: Theme.fg;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

/// A pill with a word on it: Export, and the sheet's Add.
component PillButton inherits Rectangle {
    in property <string> label;

    callback clicked();

    width: label.preferred-width + 28px;
    height: 34px;
    border-radius: 17px;
    background: touch.pressed ? Theme.accent-hover : Theme.accent;

    label := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: Theme.on-accent;
        font-size: Theme.fs-lg;
        font-weight: Theme.weight-title;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component PhoneEditor inherits Rectangle {
    in property <string> project-name;

    background: Theme.page;

    // ── what is open ─────────────────────────────────────────────────────
    //
    // The sheet over the lower half: "" for none, "library" for a library
    // page, "clip" for an inspector section, "project" for the details and
    // "ratio" for the frame shape. `sheet-tool` is the button that opened
    // it, and `sheet-title` is what the sheet is called.
    property <string> sheet;
    property <string> sheet-tool;
    property <string> sheet-title;
    property <int> library-page;
    property <string> section;
    /// The monitor alone, the timeline and tools put away.
    property <bool> full;
    /// Instagram's Reels interface drawn over a portrait frame.
    property <bool> safe-zones: true;
    /// The highlight length the sheet searches for, in seconds.
    property <float> highlight-length: 30;

    property <bool> has-clip: Editor.selected-clip.present;
    property <ClipKind> kind: Editor.selected-clip.kind;
    property <bool> is-title: root.has-clip && root.kind == ClipKind.text;

    // The back button; see Editor.back-token.
    property <bool> can-back: root.sheet != "" || root.full || root.has-clip;
    changed can-back => { Editor.back-consumable = root.can-back; }
    property <int> back-token: Editor.back-token;
    changed back-token => { root.back(); }
    init => { Editor.back-consumable = root.can-back; }

    // A clip sheet is about the selection; when the selection goes, so does
    // the sheet, rather than showing the project's details in its place.
    changed has-clip => {
        if (root.sheet == "clip" || root.sheet == "highlights"
            || (root.sheet == "library" && root.library-page >= 3)) {
            root.close();
        }
    }

    function close() {
        root.sheet = "";
        root.sheet-tool = "";
    }

    /// Puts away the top thing: a sheet, then full screen, then the
    /// selection.
    function back() {
        if (root.sheet != "") {
            root.close();
        } else if (root.full) {
            root.full = false;
        } else if (root.has-clip) {
            Editor.band-selected(-1, -1, -1px, -1px, false);
        }
    }

    function open(kind: string, id: string, title: string) {
        if (root.sheet-tool == id) {
            root.close();
            return;
        }
        root.sheet = kind;
        root.sheet-tool = id;
        root.sheet-title = title;
    }

    function run(tool: PhoneTool) {
        if (tool.id == "back") {
            root.close();
            Editor.band-selected(-1, -1, -1px, -1px, false);
        }
        // the library's pages
        else if (tool.id == "media") { root.library-page = 0; root.open("library", tool.id, tool.label); }
        else if (tool.id == "text") { root.library-page = 1; root.open("library", tool.id, tool.label); }
        else if (tool.id == "transitions") { root.library-page = 2; root.open("library", tool.id, tool.label); }
        else if (tool.id == "effects") { root.library-page = 3; root.open("library", tool.id, tool.label); }
        else if (tool.id == "filters") { root.library-page = 4; root.open("library", tool.id, tool.label); }
        else if (tool.id == "templates") { root.library-page = 5; root.open("library", tool.id, tool.label); }
        // straight to an action
        else if (tool.id == "import") { Editor.shortcut("import"); }
        else if (tool.id == "captions") { Editor.captions(); }
        else if (tool.id == "speak") { Editor.speak(); }
        else if (tool.id == "track") { Editor.add-track(); }
        else if (tool.id == "split") { Editor.split(); }
        else if (tool.id == "delete") { root.close(); Editor.delete-selected(); }
        else if (tool.id == "duplicate") { Editor.shortcut("duplicate"); }
        else if (tool.id == "freeze") { Editor.menu-selected("freeze"); }
        else if (tool.id == "detach") { Editor.menu-selected("detach"); }
        else if (tool.id == "project") { root.open("project", tool.id, tool.label); }
        else if (tool.id == "highlights") { root.open("highlights", tool.id, tool.label); }
        else if (tool.id == "fit-width") { Editor.menu-selected("fit-width"); }
        else if (tool.id == "enhance") { Editor.menu-selected("enhance"); }
        else if (tool.id == "duck") { Editor.menu-selected("duck"); }
        // everything else is one of the inspector's sections
        else {
            root.section = tool.id == "edit" || tool.id == "cutout" ? "Basic"
                : tool.id == "speed" ? "Speed"
                : tool.id == "animation" ? "Animation"
                : tool.id == "adjust" ? "Adjust"
                : tool.id == "clip-effects" ? "Effects"
                : tool.id == "sound" ? "Sound"
                : tool.id == "words" ? "Text"
                : "Layer";
            root.open("clip", tool.id, tool.label);
        }
    }

    // ── the tool rows ────────────────────────────────────────────────────
    property <[PhoneTool]> main-tools: [
        { id: "media", glyph: Glyph.film, label: I18n.t("Media") },
        { id: "import", glyph: Glyph.import, label: I18n.t("Import") },
        { id: "text", glyph: Glyph.text-mark, label: I18n.t("Text") },
        { id: "filters", glyph: Glyph.filter, label: I18n.t("Filter") },
        { id: "effects", glyph: Glyph.sparkle, label: I18n.t("FX") },
        { id: "transitions", glyph: Glyph.transition, label: I18n.t("Transitions") },
        { id: "captions", glyph: Glyph.waveform, label: I18n.t("Captions") },
        { id: "speak", glyph: Glyph.volume, label: I18n.t("Speak") },
        { id: "templates", glyph: Glyph.slot, label: I18n.t("Templates") },
        { id: "track", glyph: Glyph.rows, label: I18n.t("Add track") },
        { id: "project", glyph: Glyph.info, label: I18n.t("Project") },
    ];
    property <PhoneTool> back-tool: { id: "back", glyph: Glyph.chevron-left, label: I18n.t("Back") };
    property <[PhoneTool]> video-tools: [
        { id: "highlights", glyph: Glyph.sparkle, label: I18n.t("Highlights") },
        { id: "captions", glyph: Glyph.waveform, label: I18n.t("Captions") },
        { id: "filters", glyph: Glyph.filter, label: I18n.t("Filter") },
        { id: "edit", glyph: Glyph.fit, label: I18n.t("Trim") },
        { id: "clip-effects", glyph: Glyph.sparkle, label: I18n.t("FX") },
        { id: "split", glyph: Glyph.split, label: I18n.t("Split") },
        { id: "cutout", glyph: Glyph.brush, label: I18n.t("Cutout") },
        { id: "speed", glyph: Glyph.clock, label: I18n.t("Speed") },
        { id: "sound", glyph: Glyph.volume, label: I18n.t("Volume") },
        { id: "animation", glyph: Glyph.sparkle, label: I18n.t("Animation") },
        { id: "adjust", glyph: Glyph.sun, label: I18n.t("Adjust") },
        { id: "enhance", glyph: Glyph.sparkle, label: I18n.t("Enhance voice") },
        { id: "duck", glyph: Glyph.volume-off, label: I18n.t("Auto duck") },
        { id: "fit-width", glyph: Glyph.fit, label: I18n.t("Fit width") },
        { id: "detach", glyph: Glyph.music, label: I18n.t("Detach audio") },
        { id: "freeze", glyph: Glyph.image, label: I18n.t("Freeze") },
        { id: "duplicate", glyph: Glyph.copy, label: I18n.t("Duplicate") },
        { id: "delete", glyph: Glyph.trash, label: I18n.t("Delete") },
    ];
    property <[PhoneTool]> image-tools: [
        { id: "fit-width", glyph: Glyph.fit, label: I18n.t("Fit width") },
        { id: "filters", glyph: Glyph.filter, label: I18n.t("Filter") },
        { id: "edit", glyph: Glyph.fit, label: I18n.t("Trim") },
        { id: "clip-effects", glyph: Glyph.sparkle, label: I18n.t("FX") },
        { id: "split", glyph: Glyph.split, label: I18n.t("Split") },
        { id: "cutout", glyph: Glyph.brush, label: I18n.t("Cutout") },
        { id: "animation", glyph: Glyph.sparkle, label: I18n.t("Animation") },
        { id: "adjust", glyph: Glyph.sun, label: I18n.t("Adjust") },
        { id: "duplicate", glyph: Glyph.copy, label: I18n.t("Duplicate") },
        { id: "delete", glyph: Glyph.trash, label: I18n.t("Delete") },
    ];
    property <[PhoneTool]> audio-tools: [
        { id: "sound", glyph: Glyph.volume, label: I18n.t("Volume") },
        { id: "duck", glyph: Glyph.volume-off, label: I18n.t("Auto duck") },
        { id: "enhance", glyph: Glyph.sparkle, label: I18n.t("Enhance voice") },
        { id: "split", glyph: Glyph.split, label: I18n.t("Split") },
        { id: "speed", glyph: Glyph.clock, label: I18n.t("Speed") },
        { id: "captions", glyph: Glyph.waveform, label: I18n.t("Captions") },
        { id: "duplicate", glyph: Glyph.copy, label: I18n.t("Duplicate") },
        { id: "delete", glyph: Glyph.trash, label: I18n.t("Delete") },
    ];
    property <[PhoneTool]> text-tools: [
        { id: "words", glyph: Glyph.text-mark, label: I18n.t("Edit") },
        { id: "animation", glyph: Glyph.sparkle, label: I18n.t("Animation") },
        { id: "speak", glyph: Glyph.volume, label: I18n.t("Speak") },
        { id: "split", glyph: Glyph.split, label: I18n.t("Split") },
        { id: "duplicate", glyph: Glyph.copy, label: I18n.t("Duplicate") },
        { id: "delete", glyph: Glyph.trash, label: I18n.t("Delete") },
    ];
    property <[PhoneTool]> layer-tools: [
        { id: "layer", glyph: Glyph.filter, label: I18n.t("Filter") },
        { id: "split", glyph: Glyph.split, label: I18n.t("Split") },
        { id: "duplicate", glyph: Glyph.copy, label: I18n.t("Duplicate") },
        { id: "delete", glyph: Glyph.trash, label: I18n.t("Delete") },
    ];
    property <[PhoneTool]> tools: !root.has-clip ? root.main-tools
        : root.kind == ClipKind.image ? root.image-tools
        : root.kind == ClipKind.audio ? root.audio-tools
        : root.kind == ClipKind.text ? root.text-tools
        : root.kind == ClipKind.filter ? root.layer-tools
        : root.video-tools;

    // ── the frame shapes ─────────────────────────────────────────────────
    //
    // Rows of the engine's OUTPUTS table, as Instagram uses them: Reels and
    // Stories are 9:16, the feed takes 4:5 and 1:1, and landscape is for
    // the rest. 4K first; Instagram takes it and scales it down itself.
    property <[int]> shape-rows: [6, 2, 7, 9, 8, 3, 1, 0];
    property <[string]> shape-names: [
        "9:16 · 4K", "9:16 · 1080p", "4:5 · 4K", "4:5 · 1080p",
        "1:1 · 4K", "1:1 · 1080p", "16:9 · 4K", "16:9 · 1080p",
    ];
    property <[string]> shape-uses: [
        I18n.t("Reels and Stories"), I18n.t("Reels and Stories"),
        I18n.t("Feed, portrait"), I18n.t("Feed, portrait"),
        I18n.t("Feed, square"), I18n.t("Feed, square"),
        I18n.t("Landscape"), I18n.t("Landscape"),
    ];
    property <string> shape-now: Editor.ratio-index == 6 ? "9:16"
        : Editor.ratio-index == 2 ? "9:16"
        : Editor.ratio-index == 7 || Editor.ratio-index == 9 ? "4:5"
        : Editor.ratio-index == 8 || Editor.ratio-index == 3 ? "1:1"
        : Editor.ratio-index == 1 || Editor.ratio-index == 0 ? "16:9"
        : Editor.ratio-index == 4 ? "4:3"
        : Editor.ratio-index == 5 ? "21:9"
        : I18n.t("Custom");

    /// "1.25s", the way VN reads time.
    pure function seconds(t: float) -> string {
        return "\{Math.floor(Math.max(0, t))}."
            + Fmt.pad2(Math.mod(Math.floor(Math.max(0, t) * 100), 100)) + "s";
    }

    // ── the arrangement ──────────────────────────────────────────────────
    property <length> bar-h: 56px;
    property <length> transport-h: 48px;
    property <length> tools-h: 76px;
    property <length> strip-h: root.is-title ? 52px : 0px;
    /// A third of the screen, and never so little the lanes are unusable.
    property <length> timeline-h: Math.max(150px, root.height * 0.34);
    property <length> lower-h: root.full ? 0px
        : root.timeline-h + root.strip-h + root.tools-h;
    property <length> monitor-h: Math.max(80px,
        root.height - root.bar-h - root.transport-h - root.lower-h);
    property <length> lower-y: root.bar-h + root.monitor-h + root.transport-h;
    /// The column of add buttons beside the lanes.
    property <length> adds-w: 56px;

    // The project bar.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.bar-h;

        HorizontalLayout {
            padding-left: 4px;
            padding-right: 12px;
            spacing: 4px;

            VerticalLayout {
                alignment: center;
                BarButton {
                    glyph: Glyph.chevron-left;
                    icon-size: 24px;
                    clicked => { Editor.shortcut("close-project"); }
                }
            }

            // The frame shape, one tap from any other.
            Rectangle {
                horizontal-stretch: 1;

                shape := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: shape-row.preferred-width + 24px;
                    height: 36px;
                    border-radius: 18px;
                    background: shape-touch.pressed || root.sheet == "ratio"
                        ? Theme.field : Colors.transparent;

                    shape-row := HorizontalLayout {
                        x: 12px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Icon { glyph: Glyph.frame; size: 18px; tint: Theme.fg; }
                        }
                        Text {
                            text: root.shape-now;
                            color: Theme.fg;
                            font-size: Theme.fs-input;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Icon { glyph: Glyph.chevron-down; size: 14px; tint: Theme.fg; }
                        }
                    }

                    shape-touch := TouchArea {
                        clicked => { root.open("ratio", "ratio", I18n.t("Frame")); }
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                BarButton {
                    glyph: Glyph.settings;
                    clicked => { Editor.shortcut("settings"); }
                }
            }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 44px;
                    height: 36px;
                    border-radius: Theme.r;
                    background: save.pressed ? Theme.field-active : Theme.field;

                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        glyph: Glyph.check;
                        size: 20px;
                        tint: Theme.fg;
                    }
                    save := TouchArea {
                        clicked => { Editor.shortcut("save"); }
                    }
                }
            }

            Rectangle { width: 4px; }

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 52px;
                    height: 36px;
                    border-radius: Theme.r;
                    background: export.pressed ? Theme.accent-hover : Theme.accent;

                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        glyph: Glyph.export;
                        size: 20px;
                        tint: Theme.on-accent;
                    }
                    export := TouchArea {
                        clicked => { Editor.shortcut("export"); }
                    }
                }
            }
        }
    }

    // The monitor, with the full-screen switch in its corner.
    Seat {
        x: 0;
        y: root.bar-h;
        width: root.width;
        height: root.monitor-h;
        kind: PaneKind.preview;
        phone: true;
        safe-zones: root.safe-zones;
    }

    // The Reels safe zones, on and off.
    BarButton {
        x: root.width - self.width - 8px;
        y: root.bar-h + 8px;
        glyph: root.safe-zones ? Glyph.eye : Glyph.eye-off;
        clicked => { root.safe-zones = !root.safe-zones; }
    }

    BarButton {
        x: root.width - self.width - 8px;
        y: root.bar-h + root.monitor-h - self.height - 8px;
        glyph: root.full ? Glyph.chevron-down : Glyph.maximize;
        clicked => { root.full = !root.full; }
    }

    // The transport.
    Rectangle {
        x: 0;
        y: root.bar-h + root.monitor-h;
        width: root.width;
        height: root.transport-h;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 1px;
            background: Theme.line;
        }

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 4px;

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                alignment: start;

                Text {
                    text: root.seconds(Editor.playhead);
                    color: Theme.fg;
                    font-family: Theme.font-technical;
                    font-size: Theme.fs-lg;
                    vertical-alignment: center;
                }
                Text {
                    text: "/ " + root.seconds(Editor.preview-duration);
                    color: Theme.fg-dim;
                    font-family: Theme.font-technical;
                    font-size: Theme.fs-lg;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                BarButton {
                    glyph: Glyph.skip-back;
                    clicked => { Editor.seek(0); }
                }
            }
            VerticalLayout {
                alignment: center;
                BarButton {
                    glyph: Editor.playing ? Glyph.pause : Glyph.play;
                    icon-size: 26px;
                    clicked => { Editor.play-toggled(); }
                }
            }
            VerticalLayout {
                alignment: center;
                BarButton {
                    glyph: Glyph.skip-forward;
                    clicked => { Editor.seek(Editor.preview-duration); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            VerticalLayout {
                alignment: center;
                BarButton {
                    glyph: Glyph.undo;
                    clicked => { Editor.shortcut("undo"); }
                }
            }
            VerticalLayout {
                alignment: center;
                BarButton {
                    glyph: Glyph.redo;
                    clicked => { Editor.shortcut("redo"); }
                }
            }
        }
    }

    // ── the timeline ─────────────────────────────────────────────────────
    //
    // Kept built while a sheet covers it, so the lanes are where they were
    // left when it closes.
    Rectangle {
        x: 0;
        y: root.lower-y;
        width: root.width;
        height: root.timeline-h;
        visible: !root.full;
        background: Theme.panel;

        // What can be put on it, one lane's worth each, the way VN offers
        // them beside the lanes.
        VerticalLayout {
            x: 0;
            y: 0;
            width: root.adds-w;
            height: parent.height;
            alignment: center;
            spacing: 4px;

            BarButton {
                glyph: Glyph.music;
                clicked => { Editor.shortcut("import"); }
            }
            BarButton {
                glyph: Glyph.text-mark;
                clicked => {
                    root.library-page = 1;
                    root.open("library", "text", I18n.t("Text"));
                }
            }
            BarButton {
                glyph: Glyph.image;
                clicked => { Editor.shortcut("import"); }
            }
            BarButton {
                glyph: Glyph.film;
                clicked => {
                    root.library-page = 0;
                    root.open("library", "media", I18n.t("Media"));
                }
            }
        }

        Seat {
            x: root.adds-w;
            y: 0;
            width: parent.width - root.adds-w;
            height: parent.height;
            kind: PaneKind.timeline;
            phone: true;
        }
    }

    // ── the colour strip ─────────────────────────────────────────────────
    //
    // A title's colour, one tap per swatch, applied as it is tapped.
    if root.is-title && !root.full: Rectangle {
        x: 0;
        y: root.lower-y + root.timeline-h;
        width: root.width;
        height: root.strip-h;
        background: Theme.panel;

        Flickable {
            viewport-width: Math.max(self.width, swatches.preferred-width);

            swatches := HorizontalLayout {
                height: root.strip-h;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;

                for swatch in Theme.swatches: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: swatch;
                        border-width: Editor.selected-clip.fill == swatch ? 3px : 1px;
                        border-color: Editor.selected-clip.fill == swatch
                            ? Theme.accent : Theme.line-strong;

                        TouchArea {
                            clicked => {
                                Editor.clip-set-colour(ClipTextField.color, swatch);
                                Editor.clip-commit();
                            }
                        }
                    }
                }
            }
        }
    }

    // ── the tool row ─────────────────────────────────────────────────────
    Rectangle {
        x: 0;
        y: root.lower-y + root.timeline-h + root.strip-h;
        width: root.width;
        height: root.tools-h;
        visible: !root.full;
        background: Theme.page;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 1px;
            background: Theme.line;
        }

        // Back stays put while the clip's tools scroll beside it.
        if root.has-clip: ToolButton {
            x: 4px;
            y: 6px;
            height: parent.height - 12px;
            glyph: root.back-tool.glyph;
            label: root.back-tool.label;
            clicked => { root.run(root.back-tool); }
        }

        if root.has-clip: Rectangle {
            x: 76px;
            y: 14px;
            width: 1px;
            height: parent.height - 28px;
            background: Theme.line;
        }

        Flickable {
            x: root.has-clip ? 81px : 0px;
            y: 0;
            width: parent.width - self.x;
            height: parent.height;
            viewport-width: Math.max(self.width, row.preferred-width);
            viewport-height: self.height;

            row := HorizontalLayout {
                height: root.tools-h;
                padding: 6px;
                spacing: 2px;

                for tool in root.tools: ToolButton {
                    glyph: tool.glyph;
                    label: tool.label;
                    current: root.sheet-tool == tool.id;
                    clicked => { root.run(tool); }
                }
            }
        }
    }

    // ── the sheet ────────────────────────────────────────────────────────
    //
    // Over the lower part of the screen, and at least half of it: the
    // inspector's panels need the room, and the picture stays in view
    // above.
    if root.sheet != "": Rectangle {
        property <length> tall: Math.max(root.lower-h, root.height * 0.5);

        x: 0;
        y: root.height - self.tall;
        width: root.width;
        height: self.tall;
        background: Theme.panel;
        border-top-left-radius: Theme.r-xl;
        border-top-right-radius: Theme.r-xl;
        clip: true;

        // Nothing under the sheet takes its presses.
        TouchArea { }

        VerticalLayout {
            Rectangle {
                height: 52px;

                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.line;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 4px;
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.sheet-title;
                        color: Theme.fg;
                        font-size: Theme.fs-xl;
                        font-weight: Theme.weight-title;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // The bin's way onto the timeline: a drag cannot reach
                    // lanes the sheet is covering.
                    if root.sheet == "library" && root.library-page == 0
                        && Editor.media-selected-count > 0: VerticalLayout {
                        alignment: center;
                        PillButton {
                            label: I18n.t("Add to timeline");
                            clicked => {
                                Editor.shortcut("add-selected");
                                root.close();
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        BarButton {
                            glyph: Glyph.check;
                            clicked => { root.close(); }
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;

                if root.sheet == "library": Seat {
                    kind: PaneKind.media;
                    phone: true;
                    library-page <=> root.library-page;
                }

                if root.sheet == "clip" || root.sheet == "project": Seat {
                    kind: PaneKind.inspector;
                    phone: true;
                    only-section: root.sheet == "clip" ? root.section : "";
                }

                if root.sheet == "highlights": Flickable {
                    viewport-height: finds.preferred-height;

                    finds := VerticalLayout {
                        width: parent.width;
                        padding: 12px;
                        spacing: 10px;

                        Text {
                            text: I18n.t("Finds the liveliest stretches of the selected clip's sound. Each one becomes its own 9:16 timeline.");
                            color: Theme.fg-muted;
                            font-size: Theme.fs;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            for seconds in [15, 30, 60]: Rectangle {
                                height: 44px;
                                horizontal-stretch: 1;
                                border-radius: Theme.r;
                                background: root.highlight-length == seconds
                                    ? Theme.accent-soft : Theme.field;
                                border-width: root.highlight-length == seconds ? 1px : 0px;
                                border-color: Theme.accent;

                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "\{seconds} s";
                                    color: Theme.fg;
                                    font-size: Theme.fs-input;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { root.highlight-length = seconds; }
                                }
                            }

                            PillButton {
                                label: I18n.t("Find");
                                clicked => { Editor.highlights-find(root.highlight-length); }
                            }
                        }

                        for found[i] in Editor.highlights: Rectangle {
                            height: 60px;
                            border-radius: Theme.r;
                            background: Theme.field;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 8px;
                                spacing: 12px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 6px;

                                    Text {
                                        text: found.range;
                                        color: Theme.fg;
                                        font-family: Theme.font-technical;
                                        font-size: Theme.fs-input;
                                    }
                                    Rectangle {
                                        height: 4px;
                                        border-radius: 2px;
                                        background: Theme.well;

                                        Rectangle {
                                            x: 0;
                                            width: parent.width * found.score;
                                            height: parent.height;
                                            border-radius: 2px;
                                            background: Theme.accent;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        label: I18n.t("Make Reel");
                                        clicked => {
                                            Editor.highlight-use(i);
                                            root.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.sheet == "ratio": Flickable {
                    viewport-height: shapes.preferred-height;

                    shapes := VerticalLayout {
                        width: parent.width;
                        padding: 12px;
                        spacing: 8px;

                        for name[i] in root.shape-names: Rectangle {
                            property <bool> on: Editor.ratio-index == root.shape-rows[i];

                            height: 56px;
                            border-radius: Theme.r;
                            background: self.on ? Theme.accent-soft : Theme.field;
                            border-width: self.on ? 1px : 0px;
                            border-color: Theme.accent;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;

                                Text {
                                    horizontal-stretch: 1;
                                    text: name;
                                    color: Theme.fg;
                                    font-size: Theme.fs-input;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.shape-uses[i];
                                    color: Theme.fg-muted;
                                    font-size: Theme.fs;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => {
                                    Editor.ratio-changed(root.shape-rows[i]);
                                    root.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
