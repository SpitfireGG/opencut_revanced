import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Fmt } from "../util.slint";
import { Glyph, Icon } from "../icons.slint";
import { Editor } from "../editor.slint";
import { ClipKind, ClipTextField } from "../timeline/model.slint";
import { PaneKind } from "../workspace/pane-switcher.slint";
import { Seat } from "../workspace/seat.slint";

// The editor on a phone, held upright, laid out the way VN lays it out:
//
//   the project bar         back · frame shape · settings · save · export
//   the monitor             the picture, as large as the rest allows
//   the transport           time · start · play · end · undo · redo
//   the timeline            a third of the screen: the add buttons, then
//                           the lanes with the playhead fixed in the middle
//   the colour strip        only while a title is selected
//   the tool row            what can be added, or what can be done to the
//                           selected clip
//
// A tool that needs controls opens a sheet over the timeline and the tool
// row, and the monitor stays where it is above it, so what a slider does is
// seen as it is dragged.
//
// Nothing here is a second copy of a view. The monitor, the timeline, the
// library and the inspector are the desktop's own, in a Seat each, with
// their chrome taken off; this file is the arrangement and the tool row.

/// One button of the tool row.
export struct PhoneTool {
    /// What `run` is asked to do.
    id: string,
    glyph: Glyph,
    label: string,
}

component ToolButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <string> label;
    in property <bool> current;

    callback clicked();

    width: 58px;
    border-radius: Theme.r;
    background: touch.pressed || root.current ? Theme.field : Colors.transparent;

    VerticalLayout {
        alignment: center;
        spacing: 3px;

        HorizontalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                size: 19px;
                weight: 1.7;
                tint: root.current ? Theme.accent : Theme.fg;
            }
        }

        Text {
            text: root.label;
            color: root.current ? Theme.fg : Theme.fg-muted;
            font-size: Theme.fs-xs;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// A square icon button with a finger-sized target.
component BarButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <bool> enabled: true;
    in property <length> icon-size: 20px;

    callback clicked();

    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: touch.pressed ? Theme.field : Colors.transparent;
    opacity: root.enabled ? 1 : 0.4;

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: root.icon-size;
        weight: 1.8;
        tint: Theme.fg;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

/// A pill with a word on it: Export, and the sheet's Add.
component PillButton inherits Rectangle {
    in property <string> label;

    callback clicked();

    width: label.preferred-width + 28px;
    height: 34px;
    border-radius: 17px;
    background: touch.pressed ? Theme.accent-hover : Theme.accent;

    label := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: Theme.on-accent;
        font-size: Theme.fs-lg;
        font-weight: Theme.weight-title;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// The Reels tab's own furniture over a full-screen preview, so the edit is
/// seen as it will be: the title at the top, the account and caption at
/// the bottom. A tap anywhere plays or pauses, as a Reel does.
component ReelChrome inherits Rectangle {
    in property <string> name;

    callback closed();

    TouchArea {
        clicked => { Editor.play-toggled(); }
    }

    // Shade top and bottom, where Instagram darkens the picture under its
    // words.
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 110px;
        background: @linear-gradient(180deg, #00000080 0%, #00000000 100%);
    }
    Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: 220px;
        background: @linear-gradient(0deg, #00000099 0%, #00000000 100%);
    }

    HorizontalLayout {
        x: 0;
        y: 8px;
        width: parent.width;
        height: 48px;
        padding-left: 4px;
        padding-right: 16px;

        BarButton {
            glyph: Glyph.chevron-left;
            icon-size: 26px;
            clicked => { root.closed(); }
        }
        Text {
            horizontal-stretch: 1;
            text: I18n.t("Reels");
            color: #ffffff;
            font-size: 22px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    if !Editor.playing: Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 72px;
        height: 72px;
        border-radius: 36px;
        background: #00000066;

        Icon {
            x: (parent.width - self.width) / 2 + 3px;
            y: (parent.height - self.height) / 2;
            glyph: Glyph.play;
            size: 34px;
            tint: #ffffff;
        }
    }

    // The account and caption.
    VerticalLayout {
        x: 14px;
        y: parent.height - self.preferred-height - 36px;
        width: parent.width - 28px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 17px;
                background: Theme.accent;
                border-width: 1.5px;
                border-color: #ffffff;
            }
            Text {
                text: I18n.t("your.account");
                color: #ffffff;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle {
                width: follow.preferred-width + 20px;
                height: 28px;
                border-radius: 8px;
                border-width: 1px;
                border-color: #ffffffb3;

                follow := Text {
                    x: 10px;
                    height: parent.height;
                    text: I18n.t("Follow");
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.name;
            color: #ffffff;
            font-size: 14px;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Icon { glyph: Glyph.music; size: 13px; tint: #ffffff; }
            Text {
                text: I18n.t("Original audio");
                color: #ffffff;
                font-size: 13px;
            }
        }
    }

    // Where the Reel is: a thin bar along the bottom.
    Rectangle {
        x: 0;
        y: parent.height - 3px;
        width: parent.width;
        height: 3px;
        background: #ffffff33;

        Rectangle {
            x: 0;
            width: parent.width * Math.min(1, Editor.playhead / Math.max(0.01, Editor.preview-duration));
            height: parent.height;
            background: #ffffff;
        }
    }
}

export component PhoneEditor inherits Rectangle {
    in property <string> project-name;

    background: Theme.page;

    // ── what is open ─────────────────────────────────────────────────────
    //
    // The sheet over the lower half: "" for none, "library" for a library
    // page, "clip" for an inspector section, "project" for the details and
    // "ratio" for the frame shape. `sheet-tool` is the button that opened
    // it, and `sheet-title` is what the sheet is called.
    property <string> sheet;
    property <string> sheet-tool;
    property <string> sheet-title;
    property <int> library-page;
    property <string> section;
    /// The monitor alone, the timeline and tools put away.
    property <bool> full;
    /// Instagram's Reels interface drawn over a portrait frame.
    property <bool> safe-zones: true;
    /// The highlight length the sheet searches for, in seconds.
    property <float> highlight-length: 30;

    property <bool> has-clip: Editor.selected-clip.present;
    property <ClipKind> kind: Editor.selected-clip.kind;
    property <bool> is-title: root.has-clip && root.kind == ClipKind.text;

    // The back button; see Editor.back-token.
    property <bool> can-back: root.sheet != "" || root.full || root.has-clip;
    changed can-back => { Editor.back-consumable = root.can-back; }
    property <int> back-token: Editor.back-token;
    changed back-token => { root.back(); }
    init => { Editor.back-consumable = root.can-back; }

    // A clip sheet is about the selection; when the selection goes, so does
    // the sheet, rather than showing the project's details in its place.
    changed has-clip => {
        Editor.edge-chip = -1;
        if (!root.has-clip && (root.sheet == "clip" || root.sheet == "highlights"
            || root.sheet == "crop"
            || (root.sheet == "library" && root.library-page >= 3))) {
            root.close();
        }
    }

    function close() {
        root.sheet = "";
        root.sheet-tool = "";
    }

    /// Puts away the top thing: a sheet, then full screen, then the
    /// selection.
    function back() {
        if (root.sheet != "") {
            root.close();
        } else if (root.full) {
            root.full = false;
        } else if (root.has-clip) {
            Editor.band-selected(-1, -1, -1px, -1px, false);
        }
    }

    function open(kind: string, id: string, title: string) {
        if (root.sheet-tool == id) {
            root.close();
            return;
        }
        root.sheet = kind;
        root.sheet-tool = id;
        root.sheet-title = title;
    }

    function run(tool: PhoneTool) {
        root.tip-off();
        if (tool.id == "back") {
            root.close();
            Editor.band-selected(-1, -1, -1px, -1px, false);
        }
        // the library's pages
        else if (tool.id == "media") { root.library-page = 0; root.open("library", tool.id, tool.label); }
        else if (tool.id == "text") { root.add(1); }
        else if (tool.id == "overlay") { root.add(2); }
        else if (tool.id == "music") { root.add(3); }
        else if (tool.id == "transitions") { root.library-page = 2; root.open("library", tool.id, tool.label); }
        else if (tool.id == "effects") { root.library-page = 3; root.open("library", tool.id, tool.label); }
        else if (tool.id == "filters") { root.library-page = 4; root.open("library", tool.id, tool.label); }
        else if (tool.id == "templates") { root.library-page = 5; root.open("library", tool.id, tool.label); }
        // straight to an action
        else if (tool.id == "import") { Editor.shortcut("import-place"); }
        else if (tool.id == "captions") { Editor.captions(); }
        else if (tool.id == "speak") { Editor.speak(); }
        else if (tool.id == "track") { Editor.add-track(); }
        else if (tool.id == "split") { Editor.split(); }
        else if (tool.id == "delete") { root.close(); Editor.delete-selected(); }
        else if (tool.id == "duplicate") { Editor.shortcut("duplicate"); }
        else if (tool.id == "freeze") { Editor.menu-selected("freeze"); }
        else if (tool.id == "detach") { Editor.menu-selected("detach"); }
        else if (tool.id == "project") { root.open("project", tool.id, tool.label); }
        else if (tool.id == "ratio") { root.open("ratio", tool.id, I18n.t("Frame")); }
        else if (tool.id == "crop") { root.open("crop", tool.id, tool.label); }
        else if (tool.id == "styles") { root.open("styles", tool.id, I18n.t("Text styles")); }
        else if (tool.id == "mirror") { Editor.menu-selected("mirror"); }
        else if (tool.id == "highlights") { root.open("highlights", tool.id, tool.label); }
        else if (tool.id == "fit-width") { Editor.menu-selected("fit-width"); }
        else if (tool.id == "enhance") { Editor.menu-selected("enhance"); }
        else if (tool.id == "duck") { Editor.menu-selected("duck"); }
        // everything else is one of the inspector's sections
        else {
            root.section = tool.id == "edit" || tool.id == "cutout" ? "Basic"
                : tool.id == "speed" ? "Speed"
                : tool.id == "animation" ? "Animation"
                : tool.id == "adjust" ? "Adjust"
                : tool.id == "clip-effects" ? "Effects"
                : tool.id == "sound" ? "Sound"
                : tool.id == "words" ? "Text"
                : "Layer";
            root.open("clip", tool.id, tool.label);
        }
    }

    // ── the tool rows ────────────────────────────────────────────────────
    // The basics only for now: footage, words, overlays, sound,
    // subtitles and cutting. Looks, effects, animation and templates come
    // back once these are right.
    property <[PhoneTool]> main-tools: [
        { id: "import", glyph: Glyph.import, label: I18n.t("Import") },
        { id: "text", glyph: Glyph.text-mark, label: I18n.t("Text") },
        { id: "overlay", glyph: Glyph.image, label: I18n.t("Overlay") },
        { id: "music", glyph: Glyph.music, label: I18n.t("Music") },
        { id: "captions", glyph: Glyph.waveform, label: I18n.t("Subtitles") },
        { id: "ratio", glyph: Glyph.frame, label: I18n.t("Ratio") },
        { id: "project", glyph: Glyph.info, label: I18n.t("Project") },
    ];
    property <PhoneTool> back-tool: { id: "back", glyph: Glyph.chevron-left, label: I18n.t("Back") };
    // A clip's tools in the design's order - split, crop, volume, speed,
    // mirror - then the rest.
    property <[PhoneTool]> video-tools: [
        { id: "split", glyph: Glyph.split, label: I18n.t("Split") },
        { id: "crop", glyph: Glyph.frame, label: I18n.t("Crop") },
        { id: "sound", glyph: Glyph.volume, label: I18n.t("Volume") },
        { id: "speed", glyph: Glyph.clock, label: I18n.t("Speed") },
        { id: "mirror", glyph: Glyph.flip-h, label: I18n.t("Mirror") },
        { id: "captions", glyph: Glyph.waveform, label: I18n.t("Subtitles") },
        { id: "edit", glyph: Glyph.fit, label: I18n.t("Trim") },
        { id: "fit-width", glyph: Glyph.fit, label: I18n.t("Fit width") },
        { id: "highlights", glyph: Glyph.sparkle, label: I18n.t("Highlights") },
        { id: "detach", glyph: Glyph.music, label: I18n.t("Detach audio") },
        { id: "freeze", glyph: Glyph.image, label: I18n.t("Freeze") },
        { id: "duplicate", glyph: Glyph.copy, label: I18n.t("Duplicate") },
        { id: "delete", glyph: Glyph.trash, label: I18n.t("Delete") },
    ];
    property <[PhoneTool]> image-tools: [
        { id: "split", glyph: Glyph.split, label: I18n.t("Split") },
        { id: "crop", glyph: Glyph.frame, label: I18n.t("Crop") },
        { id: "mirror", glyph: Glyph.flip-h, label: I18n.t("Mirror") },
        { id: "fit-width", glyph: Glyph.fit, label: I18n.t("Fit width") },
        { id: "edit", glyph: Glyph.fit, label: I18n.t("Trim") },
        { id: "duplicate", glyph: Glyph.copy, label: I18n.t("Duplicate") },
        { id: "delete", glyph: Glyph.trash, label: I18n.t("Delete") },
    ];
    property <[PhoneTool]> audio-tools: [
        { id: "split", glyph: Glyph.split, label: I18n.t("Split") },
        { id: "sound", glyph: Glyph.volume, label: I18n.t("Volume") },
        { id: "speed", glyph: Glyph.clock, label: I18n.t("Speed") },
        { id: "duck", glyph: Glyph.volume-off, label: I18n.t("Auto duck") },
        { id: "duplicate", glyph: Glyph.copy, label: I18n.t("Duplicate") },
        { id: "delete", glyph: Glyph.trash, label: I18n.t("Delete") },
    ];
    property <[PhoneTool]> text-tools: [
        { id: "words", glyph: Glyph.text-mark, label: I18n.t("Edit") },
        { id: "styles", glyph: Glyph.sparkle, label: I18n.t("Style") },
        { id: "split", glyph: Glyph.split, label: I18n.t("Split") },
        { id: "duplicate", glyph: Glyph.copy, label: I18n.t("Duplicate") },
        { id: "delete", glyph: Glyph.trash, label: I18n.t("Delete") },
    ];
    property <[PhoneTool]> layer-tools: [
        { id: "delete", glyph: Glyph.trash, label: I18n.t("Delete") },
    ];
    property <[PhoneTool]> tools: !root.has-clip ? root.main-tools
        : root.kind == ClipKind.image ? root.image-tools
        : root.kind == ClipKind.audio ? root.audio-tools
        : root.kind == ClipKind.text ? root.text-tools
        : root.kind == ClipKind.filter ? root.layer-tools
        : root.video-tools;

    // ── the frame shapes ─────────────────────────────────────────────────
    //
    // Rows of the engine's OUTPUTS table, as Instagram uses them: Reels and
    // Stories are 9:16, the feed takes 4:5 and 1:1, and landscape is for
    // the rest. 4K first; Instagram takes it and scales it down itself.
    property <[int]> shape-rows: [6, 2, 7, 9, 8, 3, 1, 0];
    property <[string]> shape-names: [
        "9:16 · 4K", "9:16 · 1080p", "4:5 · 4K", "4:5 · 1080p",
        "1:1 · 4K", "1:1 · 1080p", "16:9 · 4K", "16:9 · 1080p",
    ];
    property <[string]> shape-uses: [
        I18n.t("Reels and Stories"), I18n.t("Reels and Stories"),
        I18n.t("Feed, portrait"), I18n.t("Feed, portrait"),
        I18n.t("Feed, square"), I18n.t("Feed, square"),
        I18n.t("Landscape"), I18n.t("Landscape"),
    ];

    /// "1.25s", the way VN reads time.
    pure function seconds(t: float) -> string {
        return "\{Math.floor(Math.max(0, t))}."
            + Fmt.pad2(Math.mod(Math.floor(Math.max(0, t) * 100), 100)) + "s";
    }

    // ── the arrangement ──────────────────────────────────────────────────
    property <length> bar-h: 52px;
    property <length> transport-h: 44px;
    /// The handle between the controls and the timeline.
    property <length> grip-h: 18px;
    property <length> tools-h: 58px;
    property <length> strip-h: root.is-title ? 48px : 0px;
    /// The timeline's share of the screen, dragged by its handle.
    property <float> timeline-share: 0.24;
    /// However far it is dragged, the picture keeps 140px and the tool row
    /// stays on the screen.
    property <length> timeline-room: root.height - root.bar-h - root.transport-h
        - root.grip-h - root.strip-h - root.tools-h - 140px;
    /// Never shorter than its rows - the four parts, the footage's sound
    /// and the ruler under them - and never so tall the picture goes.
    property <length> rows-h: 262px;
    property <length> timeline-h: Math.max(Math.min(root.rows-h, root.timeline-room),
        Math.min(root.timeline-room, root.height * root.timeline-share));
    property <length> lower-h: root.full ? 0px
        : root.grip-h + root.timeline-h + root.strip-h + root.tools-h;
    property <length> monitor-h: Math.max(80px,
        root.height - root.bar-h - root.transport-h - root.lower-h);
    /// Where the lanes begin.
    property <length> lower-y: root.bar-h + root.monitor-h + root.transport-h + root.grip-h;

    function tip-off() {
        Editor.tip-for = "";
        Editor.edge-chip = -1;
    }

    // A row's "add", from the timeline: what each part adds.
    property <int> add-token: Editor.add-token;
    changed add-token => { root.add(Editor.add-role); }
    function add(role: int) {
        root.tip-off();
        if (role == 0) {
            Editor.shortcut("import-footage");
        } else if (role == 1) {
            // The looks first: picking one places the title and opens its
            // words.
            root.open("styles", "text", I18n.t("Text styles"));
        } else if (role == 2) {
            Editor.shortcut("import-overlay");
        } else if (role == 3) {
            Editor.shortcut("import-place");
        } else {
            // The footage's sound switch, under its row.
            Editor.shortcut("mute-footage");
        }
    }

    // The project bar, as the design lays it: back, the project's name in
    // the middle, and two quiet icons - settings and export.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.bar-h;
        visible: !root.full;

        BarButton {
            x: 4px;
            y: (parent.height - self.height) / 2;
            glyph: Glyph.chevron-left;
            icon-size: 22px;
            clicked => { Editor.shortcut("close-project"); }
        }

        Text {
            x: 56px;
            width: parent.width - 112px;
            height: parent.height;
            text: root.project-name;
            color: Theme.fg;
            font-size: Theme.fs-lg;
            font-weight: Theme.weight-title;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        HorizontalLayout {
            x: parent.width - self.preferred-width - 4px;
            y: (parent.height - 44px) / 2;
            height: 44px;
            spacing: 0px;

            BarButton {
                glyph: Glyph.settings;
                icon-size: 19px;
                clicked => { Editor.shortcut("settings"); }
            }
            BarButton {
                glyph: Glyph.export;
                icon-size: 19px;
                clicked => { Editor.shortcut("export"); }
            }
        }
    }

    // The monitor. Full screen, it is the Reels tab: the whole screen,
    // black, the picture fitted and nothing of the editor over it.
    Seat {
        x: 0;
        y: root.full ? 0px : root.bar-h;
        width: root.width;
        height: root.full ? root.height : root.monitor-h;
        kind: PaneKind.preview;
        phone: true;
        safe-zones: root.safe-zones;
        reel: root.full;
    }

    if !root.full: BarButton {
        x: root.width - self.width - 8px;
        y: root.bar-h + 8px;
        glyph: root.safe-zones ? Glyph.eye : Glyph.eye-off;
        clicked => { root.safe-zones = !root.safe-zones; }
    }

    if root.full: ReelChrome {
        width: root.width;
        height: root.height;
        name: root.project-name;
        closed => { root.full = false; }
    }

    // The transport, as the design lays it: the time on the left, play in
    // the middle over the playhead, and undo, redo and full screen on the
    // right.
    Rectangle {
        x: 0;
        y: root.bar-h + root.monitor-h;
        width: root.width;
        height: root.transport-h;
        visible: !root.full;

        HorizontalLayout {
            x: 14px;
            width: self.preferred-width;
            height: parent.height;
            spacing: 4px;

            Text {
                text: root.seconds(Editor.playhead);
                color: Theme.fg;
                font-family: Theme.font-technical;
                font-size: Theme.fs;
                vertical-alignment: center;
            }
            Text {
                text: "/ " + root.seconds(Editor.preview-duration);
                color: Theme.fg-dim;
                font-family: Theme.font-technical;
                font-size: Theme.fs;
                vertical-alignment: center;
            }
        }

        BarButton {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            glyph: Editor.playing ? Glyph.pause : Glyph.play;
            icon-size: 24px;
            clicked => {
                root.tip-off();
                Editor.play-toggled();
            }
        }

        HorizontalLayout {
            x: parent.width - self.preferred-width - 4px;
            y: (parent.height - 44px) / 2;
            height: 44px;

            BarButton {
                glyph: Glyph.undo;
                icon-size: 18px;
                clicked => {
                    root.tip-off();
                    Editor.shortcut("undo");
                }
            }
            BarButton {
                glyph: Glyph.redo;
                icon-size: 18px;
                clicked => {
                    root.tip-off();
                    Editor.shortcut("redo");
                }
            }
            BarButton {
                glyph: Glyph.maximize;
                icon-size: 18px;
                clicked => {
                    root.close();
                    root.full = true;
                }
            }
        }
    }

    // ── the timeline ─────────────────────────────────────────────────────
    //
    // Kept built while a sheet covers it, so the lanes are where they were
    // left when it closes.
    Rectangle {
        x: 0;
        y: root.lower-y;
        width: root.width;
        height: root.timeline-h;
        visible: !root.full;
        background: Theme.panel;

        Seat {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            kind: PaneKind.timeline;
            phone: true;
        }

    }

    // ── the handle ───────────────────────────────────────────────────────
    //
    // Between the controls and the lanes. Only a drag up or down does
    // anything: it gives the timeline more or less of the screen.
    if !root.full: Rectangle {
        x: 0;
        y: root.lower-y - root.grip-h;
        width: root.width;
        height: root.grip-h;
        background: Theme.panel;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 1px;
            background: Theme.line;
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: grip.pressed ? 56px : 40px;
            height: 5px;
            border-radius: 2.5px;
            background: grip.pressed ? Theme.fg : Theme.fg-dim;

            animate width, background { duration: 140ms; easing: ease-out; }
        }

        // The handle moves as it is dragged, so the finger is measured on
        // the screen, not against the handle.
        grip := TouchArea {
            y: -8px;
            height: parent.height + 16px;
            mouse-cursor: MouseCursor.ns-resize;
            property <float> from-share;
            property <length> from-y;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.from-share = root.timeline-share;
                    self.from-y = self.absolute-position.y + self.mouse-y;
                }
            }
            moved => {
                root.timeline-share = Math.max(0.12, Math.min(root.timeline-room / root.height, self.from-share
                    - (self.absolute-position.y + self.mouse-y - self.from-y) / root.height));
            }
        }
    }

    // ── the colour strip ─────────────────────────────────────────────────
    //
    // A title's colour, one tap per swatch, applied as it is tapped.
    if root.is-title && !root.full: Rectangle {
        x: 0;
        y: root.lower-y + root.timeline-h;
        width: root.width;
        height: root.strip-h;
        background: Theme.panel;

        Flickable {
            viewport-width: Math.max(self.width, swatches.preferred-width);

            swatches := HorizontalLayout {
                height: root.strip-h;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;

                for swatch in Theme.swatches: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: swatch;
                        border-width: Editor.selected-clip.fill == swatch ? 3px : 1px;
                        border-color: Editor.selected-clip.fill == swatch
                            ? #ffffff : Theme.line-strong;

                        TouchArea {
                            clicked => {
                                Editor.clip-set-colour(ClipTextField.color, swatch);
                                Editor.clip-commit();
                            }
                        }
                    }
                }
            }
        }
    }

    // ── the tool row ─────────────────────────────────────────────────────
    Rectangle {
        x: 0;
        y: root.lower-y + root.timeline-h + root.strip-h;
        width: root.width;
        height: root.tools-h;
        visible: !root.full;
        background: Theme.page;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 1px;
            background: Theme.line;
        }

        // Back stays put while the clip's tools scroll beside it.
        if root.has-clip: ToolButton {
            x: 4px;
            y: 6px;
            height: parent.height - 12px;
            glyph: root.back-tool.glyph;
            label: root.back-tool.label;
            clicked => { root.run(root.back-tool); }
        }

        if root.has-clip: Rectangle {
            x: 76px;
            y: 14px;
            width: 1px;
            height: parent.height - 28px;
            background: Theme.line;
        }

        Flickable {
            x: root.has-clip ? 81px : 0px;
            y: 0;
            width: parent.width - self.x;
            height: parent.height;
            viewport-width: Math.max(self.width, row.preferred-width);
            viewport-height: self.height;

            row := HorizontalLayout {
                height: root.tools-h;
                padding: 6px;
                spacing: 2px;

                for tool in root.tools: ToolButton {
                    glyph: tool.glyph;
                    label: tool.label;
                    current: root.sheet-tool == tool.id;
                    clicked => { root.run(tool); }
                }
            }
        }
    }

    // A tapped handle's offer: run that end of the clip out to its media's.
    if root.has-clip && Editor.edge-chip >= 0 && root.sheet == "" && !root.full: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.bar-h + root.monitor-h - 56px - 10px - self.height - 8px;
        width: chip.preferred-width;
        height: 40px;
        border-radius: 20px;
        background: Theme.raised;
        drop-shadow-blur: 10px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000066;

        chip := HorizontalLayout {
            padding-left: 14px;
            padding-right: 4px;
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                Icon {
                    glyph: Editor.edge-chip == 0 ? Glyph.skip-back : Glyph.skip-forward;
                    size: 16px;
                    tint: Theme.accent;
                }
            }

            Text {
                text: Editor.edge-chip == 0
                    ? I18n.t("Extend to clip beginning")
                    : I18n.t("Extend to clip ending");
                color: Theme.fg;
                font-size: Theme.fs-lg;
                vertical-alignment: center;

                TouchArea {
                    clicked => {
                        Editor.menu-selected(Editor.edge-chip == 0 ? "extend-start" : "extend-end");
                        Editor.edge-chip = -1;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                BarButton {
                    width: 32px;
                    height: 32px;
                    glyph: Glyph.close;
                    icon-size: 14px;
                    clicked => { Editor.edge-chip = -1; }
                }
            }
        }
    }

    // ── the sheet ────────────────────────────────────────────────────────
    //
    // Over the lower part of the screen, and at least half of it: the
    // inspector's panels need the room, and the picture stays in view
    // above.
    if root.sheet != "": Rectangle {
        property <length> tall: Math.max(root.lower-h, root.height * 0.5);

        x: 0;
        y: root.height - self.tall;
        width: root.width;
        height: self.tall;
        background: Theme.panel;
        border-top-left-radius: Theme.r-xl;
        border-top-right-radius: Theme.r-xl;
        clip: true;

        // Nothing under the sheet takes its presses.
        TouchArea { }

        VerticalLayout {
            Rectangle {
                height: 52px;

                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.line;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 4px;
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: root.sheet-title;
                        color: Theme.fg;
                        font-size: Theme.fs-xl;
                        font-weight: Theme.weight-title;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    // The bin's way onto the timeline: a drag cannot reach
                    // lanes the sheet is covering.
                    if root.sheet == "library" && root.library-page == 0
                        && Editor.media-selected-count > 0: VerticalLayout {
                        alignment: center;
                        PillButton {
                            label: I18n.t("Add to timeline");
                            clicked => {
                                Editor.shortcut("add-selected");
                                root.close();
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        BarButton {
                            glyph: Glyph.check;
                            clicked => { root.close(); }
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;

                if root.sheet == "library": Seat {
                    kind: PaneKind.media;
                    phone: true;
                    library-page <=> root.library-page;
                }

                if root.sheet == "clip" || root.sheet == "project": Seat {
                    kind: PaneKind.inspector;
                    phone: true;
                    only-section: root.sheet == "clip" ? root.section : "";
                }

                if root.sheet == "highlights": Flickable {
                    viewport-height: finds.preferred-height;

                    finds := VerticalLayout {
                        width: parent.width;
                        padding: 12px;
                        spacing: 10px;

                        Text {
                            text: I18n.t("Finds the liveliest stretches of the selected clip's sound. Each one becomes its own 9:16 timeline.");
                            color: Theme.fg-muted;
                            font-size: Theme.fs;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            for seconds in [15, 30, 60]: Rectangle {
                                height: 44px;
                                horizontal-stretch: 1;
                                border-radius: Theme.r;
                                background: root.highlight-length == seconds
                                    ? Theme.accent-soft : Theme.field;

                                Text {
                                    width: 100%;
                                    height: 100%;
                                    text: "\{seconds} s";
                                    color: Theme.fg;
                                    font-size: Theme.fs-input;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => { root.highlight-length = seconds; }
                                }
                            }

                            PillButton {
                                label: I18n.t("Find");
                                clicked => { Editor.highlights-find(root.highlight-length); }
                            }
                        }

                        for found[i] in Editor.highlights: Rectangle {
                            height: 60px;
                            border-radius: Theme.r;
                            background: Theme.field;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 8px;
                                spacing: 12px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 6px;

                                    Text {
                                        text: found.range;
                                        color: Theme.fg;
                                        font-family: Theme.font-technical;
                                        font-size: Theme.fs-input;
                                    }
                                    Rectangle {
                                        height: 4px;
                                        border-radius: 2px;
                                        background: Theme.well;

                                        Rectangle {
                                            x: 0;
                                            width: parent.width * found.score;
                                            height: parent.height;
                                            border-radius: 2px;
                                            background: Theme.accent;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    PillButton {
                                        label: I18n.t("Make Reel");
                                        clicked => {
                                            Editor.highlight-use(i);
                                            root.close();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // The text looks, as samples: with a title selected a tap
                // restyles it and keeps its words; otherwise it places a new
                // title in that look and opens its words.
                if root.sheet == "styles": styles := Flickable {
                    property <length> gap: 10px;
                    property <length> card-w: (self.width - 28px - 2 * self.gap) / 3;
                    property <length> card-h: self.card-w * 0.72;
                    viewport-height: Math.ceil(Editor.text-presets.length / 3)
                        * (self.card-h + 22px + self.gap) + 28px;

                    for preset[i] in Editor.text-presets: Rectangle {
                        x: 14px + Math.mod(i, 3) * (styles.card-w + styles.gap);
                        y: 14px + Math.floor(i / 3) * (styles.card-h + 22px + styles.gap);
                        width: styles.card-w;
                        height: styles.card-h + 22px;

                        Rectangle {
                            width: parent.width;
                            height: styles.card-h;
                            border-radius: Theme.r;
                            background: Theme.sample-ground;
                            border-width: 1px;
                            border-color: pick.pressed ? Theme.accent : Theme.line;
                            clip: true;

                            if preset.plated: Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: Math.min(parent.width - 8px, sample.preferred-width + 14px);
                                height: sample.preferred-height + 6px;
                                border-radius: Theme.r-xs;
                                background: preset.plate;
                            }

                            sample := Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: Math.min(parent.width - 12px, self.preferred-width);
                                text: "Aa";
                                color: preset.fill;
                                font-family: preset.family;
                                font-weight: preset.weight;
                                font-italic: preset.italic;
                                font-size: Math.max(0.6, Math.min(1.6, preset.size / 0.09)) * 20px;
                                stroke: preset.stroke;
                                stroke-width: preset.stroke-width > 0 ? 1px : 0px;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }

                        Text {
                            y: styles.card-h + 4px;
                            width: parent.width;
                            text: preset.name;
                            color: Theme.fg-muted;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        pick := TouchArea {
                            clicked => {
                                if (root.is-title) {
                                    Editor.text-restyle(preset.id);
                                } else {
                                    Editor.library-add-text(preset.id);
                                    root.section = "Text";
                                    root.sheet = "clip";
                                    root.sheet-tool = "words";
                                    root.sheet-title = I18n.t("Text");
                                }
                            }
                        }
                    }
                }

                // The design's crop: the shapes as chips, each drawn as the
                // shape it cuts to, and the turns under them.
                if root.sheet == "crop": VerticalLayout {
                    padding: 14px;
                    spacing: 18px;
                    alignment: start;

                    Flickable {
                        height: 84px;
                        viewport-width: Math.max(self.width, chips.preferred-width);

                        chips := HorizontalLayout {
                            spacing: 18px;
                            alignment: start;

                            for shape in [
                                { id: "free", label: I18n.t("Free"), w: 0, h: 0 },
                                { id: "1:1", label: "1:1", w: 1, h: 1 },
                                { id: "2:3", label: "2:3", w: 2, h: 3 },
                                { id: "3:2", label: "3:2", w: 3, h: 2 },
                                { id: "3:4", label: "3:4", w: 3, h: 4 },
                                { id: "4:3", label: "4:3", w: 4, h: 3 },
                                { id: "9:16", label: "9:16", w: 9, h: 16 },
                                { id: "16:9", label: "16:9", w: 16, h: 9 },
                            ]: VerticalLayout {
                                width: 52px;
                                spacing: 8px;

                                Text {
                                    text: shape.label;
                                    color: Theme.fg;
                                    font-size: Theme.fs;
                                    horizontal-alignment: center;
                                }
                                Rectangle {
                                    height: 44px;

                                    Rectangle {
                                        property <float> long: Math.max(1, Math.max(shape.w, shape.h));
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: shape.w == 0 ? 30px : 36px * shape.w / self.long;
                                        height: shape.h == 0 ? 30px : 36px * shape.h / self.long;
                                        border-radius: 4px;
                                        border-width: 1.5px;
                                        border-color: crop-chip.pressed ? Theme.accent : Theme.fg-muted;
                                    }
                                    crop-chip := TouchArea {
                                        clicked => { Editor.menu-selected("crop:" + shape.id); }
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        PillButton {
                            label: I18n.t("Rotate");
                            clicked => { Editor.menu-selected("rotate"); }
                        }
                        PillButton {
                            label: I18n.t("Mirror");
                            clicked => { Editor.menu-selected("mirror"); }
                        }
                    }
                }

                if root.sheet == "ratio": Flickable {
                    viewport-height: shapes.preferred-height;

                    shapes := VerticalLayout {
                        width: parent.width;
                        padding: 12px;
                        spacing: 8px;

                        for name[i] in root.shape-names: Rectangle {
                            property <bool> on: Editor.ratio-index == root.shape-rows[i];

                            height: 56px;
                            border-radius: Theme.r;
                            background: self.on ? Theme.accent-soft : Theme.field;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;

                                Text {
                                    horizontal-stretch: 1;
                                    text: name;
                                    color: Theme.fg;
                                    font-size: Theme.fs-input;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.shape-uses[i];
                                    color: Theme.fg-muted;
                                    font-size: Theme.fs;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => {
                                    Editor.ratio-changed(root.shape-rows[i]);
                                    root.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
