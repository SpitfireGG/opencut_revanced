import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Fmt, Payload } from "../util.slint";
import { Glyph, Icon } from "../icons.slint";
import { ClipData, ClipKind, DropData, TimelineTool, TrackData } from "model.slint";
import { ContextMenu, MenuItemData } from "../primitives/context-menu.slint";

// The lanes: the ruler, the banded track stack, the clips on it, the playhead
// and the two band gestures.
//
// A scene graph, not one painted surface hit-tested by hand. That costs an
// element per clip and buys the hit testing: a clip carries its own
// TouchArea, so there is no `clipAt(x, y)` to keep in step with the renderer,
// and no way for the two to disagree about where a clip is.
//
// Everything is positioned from *seconds*: `px-per-second` is the only bridge,
// so zooming and panning are one property change rather than a model rewrite.
// Nothing is culled beyond `visible` — a project this size does not need it,
// and a windowing scheme is worth writing the day one does.

// ── what a kind looks like ───────────────────────────────────────────────────

// The two colours and the mark a clip wears, by kind. A global rather than
// three properties on `Clip`, because the drop ghost is not a Clip and still
// has to be painted as the clip it is about to become — and a ghost that is
// the wrong colour is worse than no ghost.
global Paint {
    public pure function mark(kind: ClipKind) -> color {
        return kind == ClipKind.audio ? Theme.kind-audio
            : kind == ClipKind.image ? Theme.kind-image
            : kind == ClipKind.text ? Theme.kind-text
            : kind == ClipKind.filter ? Theme.kind-filter
            : Theme.kind-video;
    }
    public pure function well(kind: ClipKind) -> color {
        return kind == ClipKind.audio ? Theme.kind-audio-well
            : kind == ClipKind.image ? Theme.kind-image-well
            : kind == ClipKind.text ? Theme.kind-text-well
            : kind == ClipKind.filter ? Theme.kind-filter-well
            : Theme.kind-video-well;
    }
    public pure function badge(kind: ClipKind) -> Glyph {
        return kind == ClipKind.audio ? Glyph.music
            : kind == ClipKind.image ? Glyph.image
            : kind == ClipKind.text ? Glyph.sparkle
            : kind == ClipKind.filter ? Glyph.filter
            : Glyph.film;
    }
}

// The fade ramps over one region of a clip. The shaded wedge is the part
// being taken away and the bright line is the envelope itself - the shape
// every editor draws, because it reads as "this much is being attenuated".
// Drawn at the foot of a picture clip's body, over the whole of a sound's,
// and over the whole bar of a filter layer, which is all bar.
component Ramps inherits Rectangle {
    in property <float> fade-in;
    in property <float> fade-out;
    in property <length> px-per-second;
    /// The wedges' height; they sit at the foot of this element.
    in property <length> ramp-h: root.height;

    if root.fade-in > 0: Rectangle {
        x: 0;
        y: parent.height - root.ramp-h;
        width: Math.min(parent.width, root.fade-in * root.px-per-second);
        height: root.ramp-h;

        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1;
            viewbox-height: 1;
            fit: fill;
            fill: Theme.fade-shade;
            commands: "M 0 0 L 1 0 L 0 1 Z";
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1;
            viewbox-height: 1;
            fit: fill;
            stroke: Theme.fade-edge;
            stroke-width: 1px;
            commands: "M 0 1 L 1 0";
        }
    }

    if root.fade-out > 0: Rectangle {
        x: parent.width - self.width;
        y: parent.height - root.ramp-h;
        width: Math.min(parent.width, root.fade-out * root.px-per-second);
        height: root.ramp-h;

        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1;
            viewbox-height: 1;
            fit: fill;
            fill: Theme.fade-shade;
            commands: "M 0 0 L 1 0 L 1 1 Z";
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1;
            viewbox-height: 1;
            fit: fill;
            stroke: Theme.fade-edge;
            stroke-width: 1px;
            commands: "M 0 0 L 1 1";
        }
    }
}

// ── one clip ─────────────────────────────────────────────────────────────────

component Clip inherits Rectangle {
    in property <ClipData> item;
    in property <length> px-per-second;
    in property <TimelineTool> tool;
    /// how close to an edge counts as grabbing it
    in property <length> edge-grab: 6px;
    /// The phone's rules: a clip that is not selected is part of the
    /// timeline's surface, so a drag on it pans and a tap selects it; only
    /// a clip already selected moves or trims under a finger.
    in property <bool> phone;

    /// A press landed: the caller resolves the selection before any drag.
    callback pressed(additive: bool, edge: int);
    /// Window-space delta since the press: seconds across, pixels down. Not
    /// lanes down — the lanes differ in height, so which row a drag has
    /// reached is a question only the side holding the heights can answer.
    callback dragged(seconds: float, pixels: length);
    callback released();
    callback razored(seconds: float);
    callback context-requested();
    /// Phone: a drag on an unselected clip, as the surface's pan. `dx` and
    /// `dy` run from the press.
    callback pan-started();
    callback panned(dx: length, dy: length);
    /// Phone: a handle of the selected clip tapped, not dragged. 0 head,
    /// 1 tail.
    callback edge-tapped(edge: int);
    /// Phone: the clip tapped, not dragged: its quick actions come up.
    callback tapped();
    /// The part of the clip on screen, in its own coordinates, so only the
    /// frames there are drawn.
    in property <length> view-from: 0px;
    in property <length> view-to: 100000px;

    property <color> mark: Paint.mark(root.item.kind);
    property <color> well: Paint.well(root.item.kind);
    property <Glyph> badge: Paint.badge(root.item.kind);

    /// The coloured name strip; the rest of the clip is its body. A title
    /// is all strip: its name is its words, and a body under it would show
    /// the same words a second time in a taller clip. A filter layer is all
    /// strip too - one bar, the look's mark before its name - since it has
    /// no picture and no sound to show under a header.
    ///
    /// On a phone every clip but footage is one pill - its mark, its name
    /// and its length - and footage is its frames alone, as the design
    /// draws them.
    property <bool> all-strip: root.item.kind == ClipKind.text
        || root.item.kind == ClipKind.filter
        || (root.phone && root.item.kind != ClipKind.video);
    property <length> header-h: root.phone && root.item.kind == ClipKind.video ? 0px
        : root.all-strip ? root.height : 17px;
    /// A filter layer wears its mark before its name, the way the look is
    /// told from a title or a sound on the lanes at a glance; on a phone
    /// every pill does.
    property <bool> marked: root.item.kind == ClipKind.filter
        || (root.phone && root.item.kind != ClipKind.video);
    property <length> text-x: root.marked ? 22px : 7px;
    property <length> body-h: Math.max(0px, root.height - root.header-h);
    /// The phone's sound strip under a video's frames; none without sound.
    /// A fade on a picture clip is shaded in a band at the foot instead of
    /// over the whole body: the fade is an *audio* property, and shading the
    /// picture would say it fades to black. Sound shades its whole body; a
    /// filter layer's ramp is the whole layer coming up, and it shades its
    /// whole bar.
    property <length> fade-h: root.item.kind == ClipKind.audio ? root.body-h : root.body-h * 0.45;

    /// -1 body, 0 leading edge, 1 trailing edge
    property <int> edge-at: touch.mouse-x < root.edge-grab ? 0
        : touch.mouse-x > root.width - root.edge-grab ? 1
        : -1;
    /// Its lane is locked. Rust refuses the gestures either way; this is so
    /// the clip says why before you try, rather than feeling broken.
    in property <bool> locked;

    // Neither `opacity` nor a rounded `clip` here, however much both would
    // suit. A clip element is as wide as its clip is long: ten minutes at
    // the default zoom is 12000px. `opacity` with children makes Slint
    // flatten the element into an offscreen layer that size in every
    // renderer, and a rounded `clip` does the same under femtovg-wgpu (the
    // `wgpu` feature; Skia clips a rounded rect in place). The GPU refuses
    // a texture past its limit - 8192 on the wgpu defaults - and the window
    // dies on the frame that draws it. The body and the filmstrip clip
    // themselves (square, so a scissor and not a layer); the outline is
    // drawn over the children below, and a locked lane dims through the
    // scrim after it.
    border-radius: Theme.r-sm;
    background: root.well;

    // ── body ─────────────────────────────────────────────────────────────
    Rectangle {
        x: 0;
        y: root.header-h;
        width: parent.width;
        height: root.body-h;
        clip: true;

        // The audio envelope. The commands arrive normalised into a 1x1 box
        // and `fit: fill` stretches that onto whatever width the clip has, so
        // the shape survives a zoom without Rust rebuilding the string. The
        // trade-off is per-pixel extremes when zoomed right in — there the
        // envelope is a stretched shape rather than a fresh scan of the
        // buckets.
        if root.item.wave != "" && root.item.kind == ClipKind.audio: Path {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            commands: root.item.wave;
            viewbox-width: 1;
            viewbox-height: 1;
            fit: fill;
            fill: Theme.wave;
        }

        if root.item.wave != "" && root.item.kind == ClipKind.audio: Rectangle {
            x: 0;
            y: (parent.height - 1px) / 2;
            width: parent.width;
            height: 1px;
            background: Theme.wave-centre;
        }

        // The filmstrip. Tiles are the strip's frames at the body's height,
        // and each tile shows the frame under the midpoint of as much of it
        // as is in the clip: the clip covers `span` of the footage from
        // `start`, so a tile a fraction f along the clip wants the frame at
        // start + span * f. Every tile is one Image with a source clip, so
        // a zoom changes how many tiles there are and which frame each
        // picks, never the picture itself.
        //
        // The midpoint of the *visible* part, not of the tile. The last
        // tile runs past the clip's edge, and a clip narrower than one tile
        // is all last tile: measured to the tile's own middle, a
        // two-second clip in a 210px tile asked for the frame at 1.09 of
        // its length, which clamped to the strip's final slice, and every
        // clip at that zoom showed the same last frame - or nothing. What
        // you see is the frame under the middle of what you see.
        //
        // Drawn at any width. A clip narrower than a tile shows the left
        // of one frame, cut where the clip ends - a sliver of the picture
        // is still the picture, and the well it would leave showing is not.
        if root.item.strip.frames > 0 && root.width > 0px: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            clip: true;

            property <length> tile-w: Math.max(4px,
                parent.height * root.item.strip.frame-width / Math.max(1, root.item.strip.height));
            property <int> tiles: Math.min(400, Math.ceil(parent.width / self.tile-w));
            /// Only the tiles on screen are built: a long clip zoomed in is
            /// hundreds of frames wide, and all but a dozen are off it.
            property <int> first: Math.max(0, Math.floor(root.view-from / self.tile-w));
            property <int> shown: Math.max(0, Math.min(self.tiles - self.first,
                Math.ceil((root.view-to - root.view-from) / self.tile-w) + 1));

            /// The fraction of the clip under the middle of tile `i`'s
            /// visible part.
            pure function at(i: int) -> float {
                return (i * self.tile-w + Math.min(self.width, (i + 1) * self.tile-w))
                    / 2 / Math.max(1px, self.width);
            }

            for n in self.shown: Image {
                property <int> i: parent.first + n;
                x: self.i * parent.tile-w;
                y: 0;
                width: parent.tile-w;
                height: parent.height;
                source: root.item.strip.image;
                image-fit: fill;
                source-clip-x: Math.clamp(
                    Math.floor(root.item.strip.frames
                        * (root.item.strip.start + root.item.strip.span * parent.at(self.i))),
                    0, root.item.strip.frames - 1) * root.item.strip.frame-width;
                source-clip-y: 0;
                source-clip-width: root.item.strip.frame-width;
                source-clip-height: root.item.strip.height;
            }
        }

        // Before the frames arrive, a picture clip shows its kind's mark the
        // way a bin card does — faint and large, so it reads as a placeholder
        // and not as a badge.
        if (root.item.kind == ClipKind.video || root.item.kind == ClipKind.image)
            && root.item.strip.frames == 0 && root.width > 40px: Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            glyph: root.badge;
            size: Math.min(22px, parent.height - 6px);
            tint: root.mark.with-alpha(0.3);
        }

        // The fade ramps, at the foot of the body.
        Ramps {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            fade-in: root.item.fade-in;
            fade-out: root.item.fade-out;
            px-per-second: root.px-per-second;
            ramp-h: root.fade-h;
        }

        // A transition on the cut into this clip: the wedge pair every editor
        // uses for "these two dissolve".
        if root.item.transition-in && root.width > 16px: Rectangle {
            x: 1px;
            y: (parent.height - self.height) / 2;
            width: Math.min(9px, parent.height / 2);
            height: self.width * 2;

            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 1;
                viewbox-height: 1;
                fit: fill;
                fill: Theme.transition-in;
                commands: "M 0 0 L 1 0.5 L 0 1 Z";
            }
            Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 1;
                viewbox-height: 1;
                fit: fill;
                fill: Theme.transition-out;
                commands: "M 1 0 L 0 0.5 L 1 1 Z";
            }
        }
    }

    // ── header ───────────────────────────────────────────────────────────
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.header-h;
        // The corners the clip's own rounding used to cut; an all-strip clip
        // is the whole bar, so it takes the foot's two as well.
        border-top-left-radius: Theme.r-sm;
        border-top-right-radius: Theme.r-sm;
        border-bottom-left-radius: root.all-strip ? Theme.r-sm : 0px;
        border-bottom-right-radius: root.all-strip ? Theme.r-sm : 0px;
        background: root.mark;

        // A sound's envelope runs faintly through its pill.
        if root.phone && root.item.kind == ClipKind.audio && root.item.wave != "": Path {
            x: 0;
            y: 3px;
            width: parent.width;
            height: parent.height - 6px;
            commands: root.item.wave;
            viewbox-width: 1;
            viewbox-height: 1;
            fit: fill;
            fill: Theme.clip-ink.with-alpha(0.3);
        }

        if root.marked && root.width > 20px: Icon {
            // Held at the left of what is on screen, so a clip scrolled half
            // off still says what it is.
            x: Math.max(6px, Math.min(parent.width - 20px, root.view-from + 6px));
            y: (parent.height - self.height) / 2;
            glyph: root.item.kind == ClipKind.filter ? Glyph.filter
                : root.item.kind == ClipKind.text ? Glyph.text-mark
                : root.badge;
            size: 11px;
            tint: Theme.clip-ink;
        }

        if root.width > 30px: Text {
            x: Math.max(root.text-x,
                Math.min(parent.width - 40px, root.view-from + root.text-x));
            y: 0;
            width: Math.max(0px, parent.width - self.x - 7px
                - (root.item.fx && root.width > 60px ? 20px : 0px));
            height: parent.height;
            // A title shows its own words, as they read on the picture.
            text: (root.item.kind == ClipKind.text && root.item.text-body != ""
                ? root.item.text-body : root.item.name)
                + (root.phone ? "  •  \{Fmt.round-to(root.item.duration, 2)}s" : "");
            color: Theme.clip-ink;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            overflow: elide;
        }

        // A filter layer's ramps run over its whole bar; see Ramps.
        if root.marked: Ramps {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            fade-in: root.item.fade-in;
            fade-out: root.item.fade-out;
            px-per-second: root.px-per-second;
        }

        // An `fx` chip when effects are live on the clip, so a styled clip is
        // tellable from a plain one without opening a panel.
        if root.item.fx && root.width > 60px: Rectangle {
            x: parent.width - self.width - 4px;
            y: 2.5px;
            width: 14px;
            height: parent.height - 5px;
            border-radius: Theme.r-xs;
            background: Theme.clip-chip;

            Text {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "fx";
                color: Theme.clip-ink;
                // Not a step of the scale: it is sized to the 12px chip it is
                // centred in, the way a glyph is, and moves with that and not
                // with the type.
                font-size: 9px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // ── outline ──────────────────────────────────────────────────────────
    //
    // Over the children, because they are over it: the header and the
    // filmstrip both span the whole element, and the `clip` this bar used
    // to have was what held them inside its border. Childless, so no layer.
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: Theme.r-sm;
        border-width: root.item.selected ? (root.phone ? 0px : 2px) : 1px;
        border-color: root.item.selected ? Theme.accent : root.mark;
    }

    // ── the phone's handles ──────────────────────────────────────────────
    //
    // A selected clip on a phone is held between two tabs, one per end,
    // with a rule along the top and bottom joining them: the tabs are what
    // a thumb trims with, and a tap on one offers to run that end out to
    // the media's own.
    if root.phone && root.item.selected: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: 2px;
            background: #ffffff;
        }
        Rectangle {
            x: 0;
            y: parent.height - 2px;
            width: parent.width;
            height: 2px;
            background: #ffffff;
        }

        for side in 2: Rectangle {
            x: side == 0 ? 0px : parent.width - self.width;
            y: 0;
            width: Math.min(root.edge-grab, parent.width / 2);
            height: parent.height;
            border-top-left-radius: side == 0 ? Theme.r-sm : 0px;
            border-bottom-left-radius: side == 0 ? Theme.r-sm : 0px;
            border-top-right-radius: side == 1 ? Theme.r-sm : 0px;
            border-bottom-right-radius: side == 1 ? Theme.r-sm : 0px;
            background: #ffffff;

            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                glyph: side == 0 ? Glyph.chevron-left : Glyph.chevron-right;
                size: 14px;
                weight: 2.6;
                tint: #111111;
            }
        }
    }

    // ── locked ───────────────────────────────────────────────────────────
    //
    // What `opacity: 0.55` used to say, said by a veil over the bar instead:
    // one childless rectangle, which Slint paints straight onto the frame.
    // The lane at the complementary alpha, so the clip fades toward what it
    // sits on as the opacity did, in either theme - `Theme.scrim` is black
    // and would invert the effect on the light one.
    if root.locked: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        border-radius: Theme.r-sm;
        background: Theme.lane.with-alpha(0.45);
    }

    // ── the gesture ──────────────────────────────────────────────────────
    //
    // The delta is taken in window coordinates — `absolute-position + mouse-x`
    // — and not as `mouse-x - pressed-x`. A clip moves as it is dragged, so a
    // local delta is measured against its own moving origin and cancels
    // itself out; the drag stalls after the first frame. Same reasoning, and
    // the same fix, as the workspace splitters.
    /// The tab a phone press began on, and whether it has been held.
    property <int> down-edge: -1;
    property <bool> held;
    property <bool> holding;
    Timer {
        interval: 300ms;
        running: root.holding;
        triggered => {
            root.held = true;
            root.holding = false;
        }
    }

    touch := TouchArea {
        enabled: !root.locked;
        mouse-cursor: root.tool == TimelineTool.razor ? MouseCursor.crosshair
            : root.edge-at >= 0 ? MouseCursor.ew-resize
            : MouseCursor.grab;

        pointer-event(event) => {
            if (root.phone) {
                if (event.kind == PointerEventKind.down) {
                    self.origin-x = self.absolute-position.x + self.mouse-x;
                    self.origin-y = self.absolute-position.y + self.mouse-y;
                    self.travelled = false;
                    self.moving = root.item.selected;
                    root.down-edge = root.edge-at;
                    root.held = false;
                    root.holding = true;
                    if (self.moving) {
                        root.pressed(false, root.edge-at);
                    } else {
                        root.pan-started();
                    }
                } else if (event.kind == PointerEventKind.up) {
                    root.holding = false;
                    if (self.moving) {
                        root.released();
                        // A quick tap that began and ended on the same tab;
                        // a hold or a slip off it is not one.
                        if (!self.travelled && !root.held && root.down-edge >= 0
                            && root.edge-at == root.down-edge) {
                            root.edge-tapped(root.edge-at);
                        } else if (!self.travelled && root.down-edge < 0) {
                            root.tapped();
                        }
                    } else if (!self.travelled) {
                        // A tap: select it, as a press and release with
                        // nothing moved in between.
                        root.pressed(false, -1);
                        root.released();
                        root.tapped();
                    }
                } else if (event.kind == PointerEventKind.cancel && self.moving) {
                    root.released();
                }
                return;
            }
            // The right button opens the menu and does nothing else — it must
            // not also start a move, or the menu would appear over a clip that
            // had already jumped. On the release, not the press: a press
            // holds the pointer for this area until the button comes up, and
            // a menu that opens under a held button is a menu whose first
            // click goes to the wrong element.
            if (event.button == PointerEventButton.right) {
                if (event.kind == PointerEventKind.up) {
                    root.context-requested();
                }
                return;
            }
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left) {
                if (root.tool == TimelineTool.razor) {
                    // The razor cuts where you click, not at the playhead.
                    root.razored(self.mouse-x / root.px-per-second);
                    return;
                }
                self.origin-x = self.absolute-position.x + self.mouse-x;
                self.origin-y = self.absolute-position.y + self.mouse-y;
                root.pressed(event.modifiers.shift || event.modifiers.control
                    || event.modifiers.meta, root.edge-at);
            } else if (event.kind == PointerEventKind.up
                || event.kind == PointerEventKind.cancel) {
                // Only a release ends it. Slint delivers `move` here too, so a
                // plain `else` would end the gesture the moment it began.
                root.released();
            }
        }

        moved => {
            if (root.phone) {
                self.dx = self.absolute-position.x + self.mouse-x - self.origin-x;
                self.dy = self.absolute-position.y + self.mouse-y - self.origin-y;
                if (Math.abs(self.dx) > 8px || Math.abs(self.dy) > 8px) {
                    self.travelled = true;
                }
                if (self.moving) {
                    root.dragged(self.dx / root.px-per-second, self.dy);
                } else if (self.travelled) {
                    root.panned(self.dx, self.dy);
                }
                return;
            }
            if (root.tool == TimelineTool.select) {
                root.dragged(
                    (self.absolute-position.x + self.mouse-x - self.origin-x)
                        / root.px-per-second,
                    self.absolute-position.y + self.mouse-y - self.origin-y);
            }
        }

        property <length> origin-x;
        property <length> origin-y;
        // phone only
        property <bool> travelled;
        property <bool> moving;
        property <length> dx;
        property <length> dy;
    }
}

// ── the lanes ────────────────────────────────────────────────────────────────

export component Lanes inherits Rectangle {
    in property <[TrackData]> tracks;
    in property <[ClipData]> clips;
    in property <TimelineTool> tool: TimelineTool.select;
    in property <float> playhead;
    /// The timeline's length: the end of the furthest clip on any track.
    /// On a phone the ruler and every lane run from zero to here - ten
    /// seconds while the project is empty - and nothing at all is drawn
    /// past it.
    in property <float> duration;
    property <float> drawn-end: root.duration > 0 ? root.duration : 10;
    in property <float> frame-rate: 30;
    /// Seconds at the left edge of the lanes.
    in property <float> scroll-left;
    /// The zoom: seconds covered by one pixel.
    in property <float> seconds-per-pixel: 0.05;
    in property <length> track-scroll;
    in property <length> ruler-height: 28px;
    /// The phone's timeline: the playhead holds the middle of the lanes and
    /// time moves under it. A drag pans (which is a scrub), a tap on empty
    /// lane clears the selection, and two fingers zoom.
    in property <bool> phone;

    callback scrubbed(seconds: float);
    /// Phone: a handle of a selected clip tapped; see Clip.edge-tapped.
    callback clip-edge-tapped(id: string, edge: int);
    /// Phone: a clip tapped; see Clip.tapped.
    callback clip-tapped(id: string);
    /// Phone: an empty row's "Tap to add" tapped, with the row's part.
    callback row-add(role: int);
    /// Phone: a footage clip's speaker, in the sound row, tapped.
    callback clip-mute(id: string);
    /// A press on an empty stretch of lane, before the band it may become.
    callback floor-pressed();
    callback clip-pressed(id: string, additive: bool, edge: int);
    callback clip-dragged(seconds: float, pixels: length);
    callback clip-released();
    callback razored(id: string, seconds: float);
    /// Right-click on a clip. The caller fills the menu and bumps `menu-token`;
    /// where it opens is decided here, because only this side knows where the
    /// pointer was.
    callback clip-context(id: string);
    callback menu-selected(id: string);

    in property <[MenuItemData]> menu-items;
    in property <length> menu-height;
    in property <int> menu-token;

    /// The token, but only for the Lanes that asked.
    ///
    /// `menu-token` is one number for the whole window, and a bump on it used
    /// to open every menu bound to it. That was exactly one menu while there
    /// was exactly one timeline; a second timeline seat makes it two, and the
    /// one that was not right-clicked opens at the corner of itself, because
    /// the position was only set on the one that was. So the pane that asked
    /// says so, and only its own token moves.
    property <bool> asked;
    property <int> own-token;
    changed menu-token => {
        if (root.asked) {
            root.asked = false;
            root.own-token = root.menu-token;
        }
    }
    /// A band closed over this box. Committed on release rather than live:
    /// selecting as the band sweeps looks busy and makes a mistaken sweep hard
    /// to back out of.
    callback band-selected(from-seconds: float, to-seconds: float,
        from-y: length, to-y: length, additive: bool);
    callback scrolled(seconds: float);
    callback track-scrolled(pixels: length);
    callback zoomed(factor: float, anchor-seconds: float);

    /// A drag from the library is over the lanes at this moment and this
    /// place. Asked on every move of it, because the answer — the ghost below
    /// — is where the drop would land, and that has to be recomputed as the
    /// pointer travels.
    callback drag-hovered(payload: string, seconds: float, y: length);
    /// Released here. Same three arguments: the drop is the hover, committed.
    callback dropped(payload: string, seconds: float, y: length);
    /// The answer to the last hover. `active` is also the verdict — false is
    /// how the drag is refused, and the cursor says so.
    in property <DropData> drop;

    property <length> px-per-second: 1px / Math.max(root.seconds-per-pixel, 0.000001);
    property <length> lanes-h: Math.max(0px, root.height - root.ruler-height);
    /// Seconds at the left edge as drawn. On a phone that follows the
    /// playhead, so playing scrolls the lanes and scrubbing is panning.
    ///
    /// On a phone the playhead holds the middle and the edit slides under
    /// it, as VN's does: at the start, the row icons and the cover sit in
    /// the half to its left.
    property <float> left: root.phone
        ? root.playhead - root.width / 2 / root.px-per-second
        : root.scroll-left;
    /// x of a moment, in the lanes' own coordinates
    pure function at(seconds: float) -> length {
        return (seconds - root.left) * root.px-per-second;
    }
    pure function seconds-at(x: length) -> float {
        return root.left + x / root.px-per-second;
    }

    // The phone's pan, from wherever it started: the playhead and the
    // stack's scroll at the press. One axis at a time, whichever the finger
    // has travelled further along.
    property <float> pan-playhead;
    property <length> pan-scroll;
    function pan-start() {
        root.pan-playhead = root.playhead;
        root.pan-scroll = root.track-scroll;
    }
    function pan(dx: length, dy: length) {
        if (Math.abs(dx) >= Math.abs(dy)) {
            root.scrubbed(Math.max(0, root.pan-playhead - dx / root.px-per-second));
        } else {
            root.track-scrolled(root.pan-scroll - dy - root.track-scroll);
        }
    }
    /// The zoom when two fingers went down.
    property <float> pinch-from;
    /// Pixels down the stack, from a y inside the lane area — which is what
    /// the band and the drop target both send, since which row a y lands on
    /// is the caller's to resolve. Both start at the foot of the ruler, so
    /// their local y needs only the scroll adding to it.
    pure function stack-y(y: length) -> length {
        return y + root.track-scroll;
    }
    /// The top of a row inside the lane area, scroll included.
    pure function row-y(row: int) -> length {
        return root.ruler-height + root.tracks[row].top - root.track-scroll;
    }

    // The ruler's tick ladder, from Rust. Zero means unbound, which draws no
    // ticks rather than dividing by it.
    property <float> tick: Fmt.tick-interval(root.seconds-per-pixel);
    property <float> first-tick: root.tick > 0
        ? Math.ceil(Math.max(0, root.left) / root.tick) * root.tick : 0;

    background: Theme.lane;
    clip: true;

    // Two fingers zoom about the playhead. Only on the phone: a trackpad
    // pinch on a desktop already arrives as a control-wheel below.
    pinch := ScaleRotateGestureHandler {
        enabled: root.phone;
        started => { root.pinch-from = root.seconds-per-pixel; }
        updated => {
            root.zoomed(root.pinch-from / Math.max(0.05, self.scale)
                / Math.max(root.seconds-per-pixel, 0.000001), root.playhead);
        }

        // Ancestor of everything below, so a wheel the clips do not handle bubbles
        // up to here. A sibling would not see it.
        wheel := TouchArea {
            scroll-event(event) => {
                if (event.modifiers.control || event.modifiers.meta) {
                    // Proportional to the gesture rather than a fixed notch per
                    // event. A trackpad sends a stream of small deltas, and a flat
                    // 1.15 on each one slammed through the whole zoom range in a
                    // gesture; scaling the factor by the distance travelled makes
                    // a pinch feel like it is pulling the ruler apart.
                    //
                    // Negated because Slint's delta-y is positive scrolling *up*,
                    // and up is zoom in, which means a *smaller* seconds-per-pixel.
                    //
                    // Clamped so one enormous delta — some mice send a whole
                    // page — cannot jump several octaves in a single event.
                    root.zoomed(
                        Fmt.clamp(Math.pow(1.0025, -event.delta-y / 1px), 0.5, 2.0),
                        root.seconds-at(self.mouse-x));
                    return EventResult.accept;
                }
                // A trackpad's horizontal axis always pans time. Shift does the
                // same for a wheel, which has no horizontal axis of its own.
                // Everything else scrolls the stack, which is what a plain wheel
                // means in every other list.
                if (root.phone && (event.delta-x != 0px || event.modifiers.shift)) {
                    root.scrubbed(Math.max(0, root.playhead
                        - (event.delta-x != 0px ? event.delta-x : event.delta-y)
                            / root.px-per-second));
                    return EventResult.accept;
                }
                if (event.delta-x != 0px || event.modifiers.shift) {
                    root.scrolled(Math.max(0, root.scroll-left
                        - (event.delta-x != 0px ? event.delta-x : event.delta-y)
                            / root.px-per-second));
                    return EventResult.accept;
                }
                root.track-scrolled(-event.delta-y);
                return EventResult.accept;
            }

            // ── banded lanes ─────────────────────────────────────────────────
            for track[row] in root.tracks: Rectangle {
                x: 0;
                y: root.ruler-height + track.top - root.track-scroll;
                width: parent.width;
                height: track.height;
                background: Math.mod(row, 2) == 0 ? Theme.lane : Theme.lane-alt;
                visible: !root.phone && self.y + track.height > root.ruler-height
                    && self.y < root.height;

                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.line;
                }
            }

            // The grid: one rule per ruler tick, so a clip edge can be read
            // against the ruler without following it all the way up there. Same
            // ladder, same positions — they are the same `tick`.
            for step in 64: Rectangle {
                property <float> seconds: root.first-tick + step * root.tick;

                x: root.at(self.seconds);
                y: root.ruler-height;
                width: 1px;
                height: root.lanes-h;
                background: Theme.grid;
                visible: !root.phone && root.tick > 0 && self.x >= 0px && self.x < parent.width;
            }

            // Declared before the clips, so each clip takes its own press and what
            // is left is the empty lane — which starts a band.
            band := TouchArea {
                x: 0;
                y: root.ruler-height;
                width: parent.width;
                height: root.lanes-h;

                property <bool> drawing;
                property <bool> additive;
                property <length> from-x;
                property <length> from-y;
                property <length> to-x;
                property <length> to-y;

                property <bool> travelled;

                pointer-event(event) => {
                    if (root.phone) {
                        if (event.kind == PointerEventKind.down) {
                            root.floor-pressed();
                            self.from-x = self.mouse-x;
                            self.from-y = self.mouse-y;
                            self.travelled = false;
                            root.pan-start();
                        } else if (event.kind == PointerEventKind.up && !self.travelled) {
                            // A tap on nothing: an empty band, which clears.
                            root.band-selected(-1, -1, -1px, -1px, false);
                        }
                        return;
                    }
                    if (event.kind == PointerEventKind.down) {
                        root.floor-pressed();
                        self.additive = event.modifiers.shift;
                        self.from-x = self.mouse-x;
                        self.from-y = self.mouse-y;
                        self.to-x = self.mouse-x;
                        self.to-y = self.mouse-y;
                        self.drawing = true;
                    } else if (event.kind == PointerEventKind.up
                        || event.kind == PointerEventKind.cancel) {
                        if (self.drawing) {
                            self.drawing = false;
                            root.band-selected(
                                root.seconds-at(Math.min(self.from-x, self.to-x)),
                                root.seconds-at(Math.max(self.from-x, self.to-x)),
                                root.stack-y(Math.min(self.from-y, self.to-y)),
                                root.stack-y(Math.max(self.from-y, self.to-y)),
                                self.additive);
                        }
                    }
                }

                moved => {
                    if (root.phone) {
                        if (Math.abs(self.mouse-x - self.from-x) > 8px
                            || Math.abs(self.mouse-y - self.from-y) > 8px) {
                            self.travelled = true;
                        }
                        if (self.travelled) {
                            root.pan(self.mouse-x - self.from-x, self.mouse-y - self.from-y);
                        }
                        return;
                    }
                    self.to-x = self.mouse-x;
                    self.to-y = self.mouse-y;
                }
            }

            // ── the phone's rows ─────────────────────────────────────────────
            //
            // An empty row is a bar from the start of the edit to its end
            // saying what it takes, and tapping it adds that; a row with
            // clips is its clips alone. The overlay row carries the cover
            // just before the edit starts, as the design has it.
            for track in root.tracks: Rectangle {
                property <length> from: root.at(0);
                property <length> to: root.at(root.drawn-end);

                x: Math.max(0px, self.from);
                y: root.ruler-height + track.top - root.track-scroll + 3px;
                width: Math.max(0px, Math.min(root.width, self.to) - self.x);
                height: Math.max(0px, track.height - 6px);
                visible: root.phone && track.first && track.role >= 0 && track.role <= 4
                    && track.height > 0 && self.width > 0
                    && self.y + self.height > root.ruler-height && self.y < root.height;
                border-radius: 4px;
                background: add-row.pressed ? Theme.field-active : Theme.field;

                if track.empty: Text {
                    x: Math.max(10px, -parent.from + 10px);
                    height: parent.height;
                    text: track.role == 0 ? I18n.t("Add video")
                        : track.role == 1 ? I18n.t("Add text")
                        : track.role == 2 ? I18n.t("Add photo/sticker")
                        : I18n.t("Add music");
                    color: Theme.fg-dim;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                }

                add-row := TouchArea {
                    enabled: parent.visible && track.empty;
                    clicked => { root.row-add(track.role); }
                }
            }

            // The cover, on the overlay row just before the edit starts.
            for track in root.tracks: Rectangle {
                x: root.at(0) - self.width - 6px;
                y: root.ruler-height + track.top - root.track-scroll + 2px;
                width: 78px;
                height: Math.max(0px, track.height - 4px);
                visible: root.phone && track.first && track.role == 2
                    && self.x + self.width > 0;
                border-radius: 4px;
                background: cover.pressed ? Theme.field-active : Theme.field;

                HorizontalLayout {
                    padding-left: 6px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon { glyph: Glyph.image; size: 13px; tint: Theme.fg; }
                    }
                    Text {
                        text: I18n.t("Cover");
                        color: Theme.fg;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                }

                cover := TouchArea {
                    enabled: parent.visible;
                    clicked => { root.scrubbed(0); }
                }
            }

            // The footage's sound, in the row under it: each clip's own
            // envelope with its own speaker at its start - tap it to mute
            // that clip - and the selected clip's in the accent.
            for entry in root.clips: Rectangle {
                property <TrackData> sound: root.tracks[root.tracks.length - 1];

                x: root.at(entry.start);
                y: root.ruler-height + self.sound.top - root.track-scroll + 3px;
                width: Math.max(2px, entry.duration * root.px-per-second - 2px);
                height: Math.max(0px, self.sound.height - 6px);
                visible: root.phone && entry.kind == ClipKind.video
                    && self.x + self.width > 0 && self.x < root.width;
                border-radius: 3px;
                background: Theme.field;
                clip: true;

                if entry.wave != "": Path {
                    x: 22px;
                    y: 3px;
                    width: parent.width - 24px;
                    height: parent.height - 6px;
                    commands: entry.wave;
                    viewbox-width: 1;
                    viewbox-height: 1;
                    fit: fill;
                    fill: entry.volume <= 0 ? Theme.fg-dim.with-alpha(0.35)
                        : entry.selected ? Theme.accent : Theme.fg-muted;
                }

                Rectangle {
                    x: 0;
                    width: 22px;
                    height: parent.height;
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        glyph: entry.volume <= 0 ? Glyph.volume-off : Glyph.volume;
                        size: 12px;
                        tint: entry.volume <= 0 ? Theme.fg-dim : Theme.fg;
                    }
                    TouchArea {
                        clicked => { root.clip-mute(entry.id); }
                    }
                }
            }

            // ── the clips ────────────────────────────────────────────────────
            for entry in root.clips: Clip {
                x: root.at(entry.start);
                // Both from the lane it sits on, so a clip follows its row's
                // height without a second copy of it to keep in step.
                y: root.row-y(entry.row) + 4px;
                width: Math.max(2px, entry.duration * root.px-per-second);
                height: Math.max(2px, root.tracks[entry.row].height - 10px);
                visible: self.x + self.width > 0 && self.x < root.width
                    && self.y + self.height > root.ruler-height && self.y < root.height;

                item: entry;
                px-per-second: root.px-per-second;
                tool: root.phone ? TimelineTool.select : root.tool;
                phone: root.phone;
                edge-grab: root.phone ? (entry.selected ? 20px : 0px) : 6px;
                view-from: -self.x + (root.phone ? 44px : 0px);
                view-to: root.width - self.x;
                pan-started => { root.pan-start(); }
                panned(dx, dy) => { root.pan(dx, dy); }
                edge-tapped(edge) => { root.clip-edge-tapped(entry.id, edge); }
                tapped => { root.clip-tapped(entry.id); }
                // Read back through the lane the clip sits on rather than carried
                // on the clip: locking is a property of the lane, and copying it
                // onto every clip would be one more thing to keep in step.
                locked: root.tracks[entry.row].locked;

                pressed(additive, edge) => { root.clip-pressed(entry.id, additive, edge); }
                dragged(seconds, pixels) => { root.clip-dragged(seconds, pixels); }
                released => { root.clip-released(); }
                razored(seconds) => { root.razored(entry.id, entry.start + seconds); }
                context-requested => {
                    // Captured before the round trip: by the time the items come
                    // back the pointer may have moved, and a menu that opens away
                    // from the click reads as a misfire. `asked` goes up first for
                    // the same reason — the call below publishes before it
                    // returns, so the token can arrive inside it.
                    menu.request-x = wheel.mouse-x;
                    menu.request-y = wheel.mouse-y;
                    root.asked = true;
                    root.clip-context(entry.id);
                }
            }

            // ── the band being drawn ─────────────────────────────────────────
            if band.drawing: Rectangle {
                x: Math.min(band.from-x, band.to-x);
                y: root.ruler-height + Math.min(band.from-y, band.to-y);
                width: Math.max(band.from-x, band.to-x) - Math.min(band.from-x, band.to-x);
                height: Math.max(band.from-y, band.to-y) - Math.min(band.from-y, band.to-y);
                background: Theme.accent-soft;
                border-width: 1px;
                border-color: Theme.accent;
            }

            // ── the drop target ──────────────────────────────────────────────
            //
            // Declared after the clips, so a drag reaches it before them — but a
            // TouchArea ignores drag events and a DropArea ignores everything
            // else, so the two never take each other's. It covers the lanes and
            // not the ruler: a drop is a placement on a track, and the ruler is
            // where time is scrubbed.
            landing := DropArea {
                x: 0;
                y: root.ruler-height;
                width: parent.width;
                height: root.lanes-h;

                can-drop(event) => {
                    // Rust is asked rather than told: it is the side that knows
                    // how long the media runs, what the payload names, and where
                    // the snap will pull the start to. It answers by publishing
                    // `drop`, which is both the ghost and the verdict — so this
                    // reads its own answer back, one statement later.
                    root.drag-hovered(Payload.text(event.data),
                        root.seconds-at(event.position.x),
                        root.stack-y(event.position.y));
                    return root.drop.active ? DragAction.copy : DragAction.none;
                }

                dropped(event) => {
                    root.dropped(Payload.text(event.data),
                        root.seconds-at(event.position.x),
                        root.stack-y(event.position.y));
                    return DragAction.copy;
                }
            }

            // ── the ghost ────────────────────────────────────────────────────
            //
            // The clip the drop will make, drawn where it will make it. Gated on
            // `has-drag` as well as on Rust's verdict: a drag that leaves the
            // lanes gets an Exit and no further hover, so without it the ghost
            // would sit there after the pointer had gone.
            if root.drop.active && landing.has-drag: Rectangle {
                x: root.at(root.drop.start);
                y: root.row-y(root.drop.row) + 4px;
                width: Math.max(2px, root.drop.duration * root.px-per-second);
                height: Math.max(2px, root.tracks[root.drop.row].height - 10px);
                border-radius: Theme.r-sm;
                // Alpha in the paints, not `opacity`, and no rounded `clip`
                // either: both make Slint flatten this element into an
                // offscreen layer (the clip only under femtovg-wgpu), and a
                // ghost is as wide as the clip it will make - a ten-minute drop
                // at the default zoom asks for a 12000px texture and the GPU
                // refuses past 8192. The children stay inside it on their own,
                // so nothing needs clipping.
                background: Paint.well(root.drop.kind).with-alpha(0.85);
                // The accent, not the kind's mark: this is a target, and every
                // other target in the window — the band, a selected clip — is
                // outlined in it.
                border-width: 2px;
                border-color: Theme.accent.with-alpha(0.85);

                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: 17px;
                    // The corners the ghost's own rounding used to cut.
                    border-top-left-radius: Theme.r-sm;
                    border-top-right-radius: Theme.r-sm;
                    background: Paint.mark(root.drop.kind).with-alpha(0.85);

                    if parent.width > 30px: Text {
                        x: 7px;
                        y: 0;
                        width: parent.width - 14px;
                        height: parent.height;
                        text: root.drop.label;
                        color: Theme.clip-ink.with-alpha(0.85);
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            // ── the razor guide ──────────────────────────────────────────────
            //
            // Follows the pointer so the cut is visible before it is made. The
            // outer TouchArea is hovered even while the pointer is over a clip,
            // which is what keeps the guide alive across one.
            if root.tool == TimelineTool.razor && wheel.has-hover: Rectangle {
                x: wheel.mouse-x;
                y: root.ruler-height;
                width: 1px;
                height: root.lanes-h;
                background: Theme.fg;
                opacity: 0.5;
            }

            // ── the ruler ────────────────────────────────────────────────────
            //
            // Last, so it paints over any lane scrolled up behind it, and so its
            // scrub area sits above the band's.
            if !root.phone: Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: root.ruler-height;
                background: Theme.ruler;
                clip: true;

                // Fixed count, clipped to the pane. A tick count derived from the
                // width would tear down and rebuild the whole row on every frame
                // of a splitter drag; 64 covers any window at the 90px minimum
                // spacing the ladder guarantees.
                for step in 64: Rectangle {
                    property <float> seconds: root.first-tick + step * root.tick;

                    x: root.at(self.seconds);
                    y: 0;
                    // Wide enough for the label it carries; the mark itself is the
                    // 1px child pinned at this cell's leading edge.
                    width: 64px;
                    height: root.ruler-height;
                    background: Colors.transparent;
                    visible: root.tick > 0 && self.x < parent.width;

                    Rectangle {
                        x: 0;
                        y: parent.height - 7px;
                        width: 1px;
                        height: 7px;
                        background: Theme.line-strong;
                    }

                    // Four minor marks between majors on a phone.
                    for minor in (root.phone ? 4 : 0): Rectangle {
                        x: (minor + 1) * root.tick * root.px-per-second / 5;
                        y: parent.height - 4px;
                        width: 1px;
                        height: 4px;
                        background: Theme.line;
                    }

                    Text {
                        x: 5px;
                        y: 0;
                        width: parent.width - 7px;
                        height: parent.height - 7px;
                        // "0s", "2s", "0.5s", "1:04" on a phone, as VN spells
                        // them: whole seconds, or the tick's own decimals
                        // when the ladder is finer than a second.
                        text: !root.phone
                            ? Fmt.frames-timecode(parent.seconds, root.frame-rate)
                            : parent.seconds >= 60
                                ? Fmt.short-duration(parent.seconds)
                            : root.tick >= 1 ? "\{Math.round(parent.seconds)}s"
                            : "\{Fmt.round-to(parent.seconds, 2)}s";
                        color: Theme.fg-dim;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    x: 0;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.line;
                }

                // The ruler is the scrub strip. Dragging in the lanes draws a
                // band instead — the convention every NLE shares, and the only way
                // the two gestures can share one surface.
                scrub := TouchArea {
                    mouse-cursor: pointer;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.scrubbed(Math.max(0, root.seconds-at(self.mouse-x)));
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.scrubbed(Math.max(0, root.seconds-at(self.mouse-x)));
                        }
                    }
                }
            }

            // Last of all, so its surface is over everything. A PopupWindow is its
            // own layer and escapes this pane's clip, but the element that places
            // it still has to be able to measure the space it is placing into.
            menu := ContextMenu {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                items: root.menu-items;
                menu-height: root.menu-height;
                token: root.own-token;
                selected(id) => { root.menu-selected(id); }
            }

            // ── the phone's plus between footage clips ───────────────────────
            //
            // A small square at the end of every piece of footage, as the
            // design has between clips: more footage.
            for entry in root.clips: Rectangle {
                x: root.at(entry.start + entry.duration) - self.width / 2;
                y: root.row-y(entry.row) + (root.tracks[entry.row].height - self.height) / 2;
                width: 18px;
                height: 18px;
                // Between clips only: at the timeline's end it would sit
                // past it, and past the end nothing is drawn.
                visible: root.phone && entry.kind == ClipKind.video
                    && entry.start + entry.duration < root.duration - 0.01
                    && self.x + self.width > 0 && self.x < root.width;
                border-radius: 4px;
                background: plus.pressed ? Theme.accent : #ffffff;

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    glyph: Glyph.plus;
                    size: 12px;
                    weight: 2.4;
                    tint: #111111;
                }

                plus := TouchArea {
                    enabled: parent.visible;
                    clicked => { root.row-add(0); }
                }
            }

            // ── the phone's icon column ───────────────────────────────────────
            //
            // Fixed at the left and never moving: each row's icon, level with
            // its row, over a strip the edit slides under.
            if root.phone: Rectangle {
                x: 0;
                y: 0;
                width: 44px;
                height: root.height;
                background: Theme.lane;
            }

            for track in root.tracks: Rectangle {
                x: 4px;
                y: root.ruler-height + track.top - root.track-scroll
                    + (track.height - self.height) / 2;
                width: 36px;
                height: Math.min(32px, track.height);
                visible: root.phone && track.first && track.height > 0
                    && track.role >= 0 && track.role <= 4
                    && self.y + self.height > 0 && self.y < root.height;
                border-radius: 8px;
                background: row-icon.pressed ? Theme.field : Colors.transparent;

                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    glyph: track.role == 0 ? Glyph.film
                        : track.role == 1 ? Glyph.text-mark
                        : track.role == 2 ? Glyph.image
                        : track.role == 3 ? Glyph.music
                        : track.muted ? Glyph.volume-off : Glyph.volume;
                    size: 16px;
                    weight: 1.7;
                    tint: Theme.fg-muted;
                }

                row-icon := TouchArea {
                    enabled: parent.visible;
                    clicked => { root.row-add(track.role); }
                }
            }

            // ── the phone's ruler, under the rows ─────────────────────────────
            if root.phone && root.tracks.length > 0: Rectangle {
                property <TrackData> last: root.tracks[root.tracks.length - 1];

                x: 44px;
                y: root.ruler-height + self.last.top + self.last.height - root.track-scroll + 2px;
                width: root.width - 44px;
                height: 20px;
                clip: true;

                for step in 64: Rectangle {
                    property <float> seconds: root.first-tick + step * root.tick;

                    x: root.at(self.seconds) - parent.x;
                    y: 0;
                    width: 64px;
                    height: parent.height;
                    visible: root.tick > 0 && self.seconds <= root.drawn-end + 0.001
                        && self.x > -64px && self.x < parent.width;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 1px;
                        height: 5px;
                        background: Theme.fg-dim;
                    }
                    for minor in 4: Rectangle {
                        x: (minor + 1) * root.tick * root.px-per-second / 5;
                        y: 0;
                        width: 1px;
                        height: 3px;
                        visible: parent.seconds + (minor + 1) * root.tick / 5 <= root.drawn-end;
                        background: Theme.line-strong;
                    }
                    Text {
                        x: 0;
                        y: 6px;
                        text: parent.seconds >= 60 ? Fmt.short-duration(parent.seconds)
                            : root.tick >= 1 ? "\{Math.round(parent.seconds)}s"
                            : "\{Fmt.round-to(parent.seconds, 2)}s";
                        color: Theme.fg-dim;
                        font-size: Theme.fs-xs;
                    }
                }
            }

            // ── the phone's playhead ─────────────────────────────────────────
            //
            // A white line with a head under the ruler and a knob at the
            // foot. Dragging the knob jogs through the edit, a pixel of drag
            // a pixel of time at the current zoom.
            if root.phone: Rectangle {
                x: root.at(root.playhead) - self.width / 2;
                y: 0;
                width: 28px;
                height: root.height;

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 0;
                    width: 2px;
                    height: parent.height - 18px;
                    border-radius: 1px;
                    background: #ffffff;
                    drop-shadow-blur: 3px;
                    drop-shadow-color: #00000080;
                }

                knob := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 2px;
                    width: 22px;
                    height: 14px;
                    border-radius: 7px;
                    background: jog.pressed ? Theme.accent : #ffffff;
                    drop-shadow-blur: 4px;
                    drop-shadow-color: #00000080;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 3px;
                        for i in 2: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 1.5px;
                                height: 6px;
                                background: #00000066;
                            }
                        }
                    }
                }

                jog := TouchArea {
                    x: knob.x - 10px;
                    y: knob.y - 14px;
                    width: knob.width + 20px;
                    height: knob.height + 16px;
                    property <float> from-time;
                    property <length> from-x;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            self.from-time = root.playhead;
                            self.from-x = self.absolute-position.x + self.mouse-x;
                        }
                    }
                    moved => {
                        root.scrubbed(Math.max(0, self.from-time
                            + (self.absolute-position.x + self.mouse-x - self.from-x)
                                / root.px-per-second));
                    }
                }
            }

            // ── the playhead ─────────────────────────────────────────────────
            //
            // Over everything, ruler included: it is the one thing that must never
            // be behind a clip.
            if !root.phone: Rectangle {
                x: root.at(root.playhead);
                y: 0;
                width: 1px;
                height: root.height;
                background: Theme.playhead;
                visible: self.x >= -1px && self.x <= root.width;

                Rectangle {
                    x: -5px;
                    y: 0;
                    width: 11px;
                    height: 9px;

                    Path {
                        width: parent.width;
                        height: parent.height;
                        viewbox-width: 1;
                        viewbox-height: 1;
                        fit: fill;
                        fill: Theme.playhead;
                        commands: "M 0 0 L 1 0 L 0.5 1 Z";
                    }
                }
            }
        }
    }
}
